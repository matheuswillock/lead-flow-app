# Bethânia — N8N (dev local)
# Copie para `.env.n8n`: `cp .env.n8n.example .env.n8n`

# n8n 2.x: obrigatório false — workflows usam $env em expressões/Code nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_RUNNERS_ENABLED=false

# API do Corretor Studio vista de dentro do container N8N
LEAD_FLOW_API_BASE_URL=http://host.docker.internal:3000
N8N_WEBHOOK_BASE_URL=http://host.docker.internal:5678

# HMAC compartilhado com o Next.js (.env BACKOFFICE_STUDIO_BOT_WEBHOOK_SECRET)
BACKOFFICE_STUDIO_BOT_WEBHOOK_SECRET=change-me-studio-bot-webhook-secret

# Evolution (rede interna docker em prod; no host local use a URL publicada)
EVO_API_BASE_URL=http://127.0.0.1:8080
EVO_API_KEY=leadflow-local-evo-key
EVO_BETHANIA_INSTANCE=bethania
BACKOFFICE_BETHANIA_WHATSAPP_NUMBER=

# Alerta de falha (Estágio 4) — Incoming Webhook Slack
BETHANIA_SLACK_WEBHOOK_URL=
