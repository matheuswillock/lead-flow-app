# Evolution API — copie para .env.evolution (gitignored)
# AUTHENTICATION_API_KEY deve ser idêntica a EVO_API_KEY no .env do Lead Flow

AUTHENTICATION_API_KEY=leadflow-local-evo-key
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
# Dev local: http://127.0.0.1:8080 | Produção VPS: https://<URL-EVOLUTION>
SERVER_URL=http://127.0.0.1:8080
SERVER_DISABLE_DOCS=false
SERVER_DISABLE_MANAGER=false

# Bind da porta no host (lido pelo docker-compose.evolution.yml)
# Dev: 127.0.0.1:8080 | VPS: 0.0.0.0:8080
EVOLUTION_API_BIND=127.0.0.1:8080

# Supabase corretor-studio-evolution (project ref: kzwzgkfgynfwodjmfdli)
# Substitua [PASSWORD] pela senha do Postgres no dashboard Supabase.
DATABASE_PROVIDER=psql_bouncer
# Session pooler (:5432) — migrations Prisma na subida do container
DATABASE_CONNECTION_URI=postgresql://postgres.kzwzgkfgynfwodjmfdli:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?schema=evolution_api
# Transaction pooler (:6543) — tráfego da API em runtime
DATABASE_BOUNCER_CONNECTION_URI=postgresql://postgres.kzwzgkfgynfwodjmfdli:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_HISTORIC=true

# Referência Supabase (Evolution não consome Auth hoje — só Postgres acima)
# SUPABASE_URL=https://kzwzgkfgynfwodjmfdli.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<publishable key do dashboard>
# SUPABASE_SECRET_KEY=<secret key do dashboard>
# SUPABASE_JWKS_URL=https://kzwzgkfgynfwodjmfdli.supabase.co/auth/v1/.well-known/jwks.json

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379
CACHE_REDIS_PREFIX_KEY=evolution-cache
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=true
CACHE_LOCAL_ENABLED=true
CACHE_LOCAL_TTL=86400

LANGUAGE=pt-BR
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error

# Versão do cliente WhatsApp — deve corresponder à do seu celular (WhatsApp → Aparelhos conectados → ⋮ → Ajuda).
# Se o scan falhar com "Não foi possível conectar o dispositivo", atualize este valor e rode `bun run evo:reset`.
CONFIG_SESSION_PHONE_VERSION=2.3000.1041976118

WEBHOOK_GLOBAL_ENABLED=false
WEBSOCKET_ENABLED=true
