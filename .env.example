# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_LEAD_ATTACHMENTS_BUCKET=lead-attachments
SUPABASE_PROFILE_ICONS_BUCKET=profile-icons
SUPABASE_EMAIL_TEMPLATE_ASSETS_BUCKET=email-template-assets
SUPABASE_CONTRACTS_BUCKET=backoffice-contracts
SUPABASE_SUPPORT_ATTACHMENTS_BUCKET=support-request-attachments

# Database PostgreSQL (Supabase example)
# POSTGRES_PASSWORD é opcional se DIRECT_URL/DATABASE_URL já incluem a senha (usado em db:clone:remote).
POSTGRES_USER=postgres.your-project-ref
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=aws-1-sa-east-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
# Em serverless (Vercel), connection_limit=1 e pool_timeout=20 evitam esgotamento
# do pool do Supavisor (erros P2024). Produção: atualizar a env DATABASE_URL na Vercel.
DATABASE_URL=postgresql://postgres.your-project-ref:your_postgres_password@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20
# Pool maior só no cron de import de contatos (sync Radar paralelo). Default: 6.
# IMPORT_CRON_CONNECTION_LIMIT=6
# Pool do cron de disparo de e-mail (dispatch-scheduled). Default: 3.
# EMAIL_CRON_CONNECTION_LIMIT=3
# Semáforo por isolate no webhook Resend (after-hook). Default: 2.
# RESEND_WEBHOOK_MAX_CONCURRENT=2
# Concorrência de chunks de 100 destinatários dentro do mesmo dispatchBatch
# (cada chunk é 1 chamada resend.batch.send). Default 1 = sequencial (comportamento
# atual). Só subir depois de confirmar o rate limit real da conta no dashboard da
# Resend (header ratelimit-limit); default documentado da API hoje é 10 req/s/time.
# EMAIL_DISPATCH_CHUNK_CONCURRENCY=1
# Concorrência máxima de recálculo de engajamento Radar (coalesce). Default: 2.
# RADAR_ENGAGEMENT_SCORE_MAX_IN_FLIGHT=2
# Outbox Radar D9 (cron sync-email-contacts): batch default 250 (~3000/h com */5),
# concorrência default 8 (orçamento ~concurrency+1 conexões no worker).
# Precedência: config ativa salva no backoffice (/backoffice/radar/outbox) → estes envs → defaults.
# Sem seed automático: envs continuam válidos até o primeiro save na UI.
# Limites hard: batch 1–500, concorrência 1–16.
# RADAR_EMAIL_CONTACT_SYNC_OUTBOX_BATCH_SIZE=250
# RADAR_SYNC_CONCURRENCY=8
DIRECT_URL=postgresql://postgres.your-project-ref:your_postgres_password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# DB local + Realtime local (híbrido) — `bun run dev`/`dev:local` aplicam estes
# overrides automaticamente (não precisa descomentar para uso normal).
# Login (Auth) e Storage continuam remotos; só dados (Prisma) e Realtime são locais.
# Configuração dos segredos remotos usados pelo Realtime local:
#   docker/local/.env.local-stack (NUNCA commitar — copie de .env.local-stack.example)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321   # proxy local (Caddy)
#
# Precisa do Supabase completo local (Auth/Storage/Studio locais)? Use
# `bun run dev -- --full-supabase` (usa `supabase start`, mais pesado).
#
# ⚠️ Auth/Storage não têm sandbox local no stack híbrido: ações admin
# (deletar usuário, upload/delete de Storage) ficam bloqueadas por padrão
# (createSupabaseAdmin retorna null) — habilite via
# SUPABASE_LOCAL_ALLOW_REMOTE_ADMIN=true em docker/local/.env.local-stack,
# e só com um projeto Supabase de desenvolvimento isolado (nunca produção).

# Resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_TEST_MODE=false
RESEND_OWNER_EMAIL=owner@example.com
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret
EMAIL_UNSUBSCRIBE_SECRET=your_random_unsubscribe_hmac_secret_here
# Webhook Resend: incluir email.sent, email.delivered, email.opened, email.clicked,
# email.bounced, email.complained, domain.created, domain.updated, domain.deleted

# Slack — pedidos de suporte
# Incoming Webhook do canal de suporte (https://api.slack.com/apps → Incoming Webhooks)
SLACK_SUPPORT_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
# Incoming Webhook do canal de leads do backoffice (obrigatório)
SLACK_BACKOFFICE_LEADS_WEBHOOK_URL=https://hooks.slack.com/services/your/backoffice-leads/webhook

# Cron Jobs (Vercel)
CRON_SECRET=your_random_cron_secret_here

# Web Push (notificações no navegador)
# Gerar com: bunx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:suporte@corretorstudio.com.br
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Asaas Payment Gateway
ASAAS_API_KEY=aact_hmlg_your_sandbox_api_key
ASAAS_WALLET_ID=your_asaas_wallet_id
ASAAS_WEBHOOK_TOKEN=your_asaas_webhook_token
ASAAS_ENV=sandbox
ASAAS_URL=https://sandbox.asaas.com
ASAAS_URL_sandbox=https://sandbox.asaas.com

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_API_BASE_URL=/api/v1

# Lead form embed (opcional) — origens extras para iframe/webview (CSV)
# Padrão já inclui https://*.3c.plus, Meta e WhatsApp. Use para white-label do 3C Plus.
# LEAD_FORM_FRAME_ANCESTORS=https://cliente.exemplo.com,https://painel.outro.com
# Extra origins allowed to embed LiveFrame public routes only (/, /prime, /recursos).
# Defaults include Willocks House + localhost. Tenant/backoffice remain DENY.
# SITE_FRAME_ANCESTORS=https://preview.exemplo.com

# Encryption keys
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_server_encryption_key_64_hex
NEXT_PUBLIC_ENCRYPTION_KEY=your_public_encryption_key_64_hex

# Integrations (Meta / WhatsApp)
# Use 32 bytes key (64 hex) or base64 (44 chars)
INTEGRATIONS_ENCRYPTION_KEY=your_integrations_encryption_key
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=meta_lead_webhook_verify_token

# Google OAuth (Calendar + login local/remoto)
# Stack híbrido (padrão): Auth é sempre remoto — configure só o Redirect URI remoto.
# Remoto: https://<project-ref>.supabase.co/auth/v1/callback
# --full-supabase (Auth local via supabase start): habilite em supabase/config.toml
# ([auth.external.google]) e adicione no Google Cloud Console:
#   Redirect URI: http://127.0.0.1:55321/auth/v1/callback  (porta do Supabase local, NÃO 3000)
#   Origem JS: http://127.0.0.1:3000 e http://localhost:3000
# Após alterar config.toml: `supabase stop && supabase start` (ou reinicie `bun dev -- --full-supabase`).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Sentry (Error Tracking)
# DSN: Settings → Client Keys (DSN) in your Sentry project
NEXT_PUBLIC_SENTRY_DSN=https://your_public_key@o0.ingest.sentry.io/0
# Auth token: Settings → Auth Tokens in your Sentry org (write source maps scope)
# Also stored in .env.sentry-build-plugin for the Sentry build plugin
SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here

# WhatsApp — OpenWA Gateway (whatsapp-web.js)
# URL base do Gateway na VPS / Docker (sem barra final). Dev: compose sobe openwa:3333.
OPENWA_API_URL=http://127.0.0.1:3333
# Gere com: openssl rand -hex 32
OPENWA_API_KEY=leadflow-local-openwa-key-change-me-32b
OPENWA_WEBHOOK_SECRET=leadflow-local-openwa-webhook-secret-32chars
# Allowlist de rollout da Inbox V3 (obrigatórias em produção; sem valor = V3 desabilitado).
# Use * para habilitar todos os times, ou UUIDs separados por vírgula para rollout gradual.
WHATSAPP_V3_SEND_TEAM_IDS=
WHATSAPP_V3_CONTACTS_TEAM_IDS=
WHATSAPP_V3_SEARCH_TEAM_IDS=
WHATSAPP_V3_SYNC_TEAM_IDS=
# N8N (Bethânia — dev local ou VPS)
# Dev: cp .env.n8n.example .env.n8n | VPS: deploy/hostinger/.env.n8n.production.example
# `bun run dev` lê BACKOFFICE_STUDIO_BOT_WEBHOOK_SECRET de .env.n8n quando N8N_BASE_URL é localhost.
# Workflows usam LEAD_FLOW_API_BASE_URL (dev: http://host.docker.internal:3000)
# N8N_BASE_URL=http://127.0.0.1:5678
# N8N_WEBHOOK_BASE_URL=http://host.docker.internal:5678
# BACKOFFICE_N8N_OUTBOUND_URL=http://127.0.0.1:5678/webhook/bethania-outbound
# BACKOFFICE_STUDIO_BOT_WEBHOOK_SECRET=leadflow-local-studio-bot-secret
# N8N_BETHANIA_INBOUND_PATH=/webhook/bethania-inbound
# EVO_BETHANIA_INSTANCE=bethania
# BACKOFFICE_BETHANIA_WHATSAPP_NUMBER=
# Produção VPS + Vercel: deploy/hostinger/README.md e vercel-env.production.example
# NEXT_PUBLIC_BETHANIA_WHATSAPP_NUMBER=5511999999999
# SUPABASE_BACKOFFICE_BOT_BUCKET=backoffice-bot
# Bethânia AI v2 (Fase 0): DB kill switch permanece desligado até Zero Data Retention + aprovação.
# BACKOFFICE_GROQ_API_KEY=
# BACKOFFICE_BETHANIA_AI_BASE_URL=https://api.groq.com/openai/v1
# BACKOFFICE_BETHANIA_AI_ROLLUP_CRON_SECRET=
# GROQ_API_KEY= # alias legado
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1
