# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_LEAD_ATTACHMENTS_BUCKET=lead-attachments
SUPABASE_PROFILE_ICONS_BUCKET=profile-icons
SUPABASE_EMAIL_TEMPLATE_ASSETS_BUCKET=email-template-assets

# Database PostgreSQL (Supabase example)
# POSTGRES_PASSWORD é opcional se DIRECT_URL/DATABASE_URL já incluem a senha (usado em db:clone:remote).
POSTGRES_USER=postgres.your-project-ref
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=aws-1-sa-east-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your_postgres_password@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:your_postgres_password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# Database PostgreSQL — banco local via Supabase CLI (`bun run dev:local` aplica overrides automaticamente)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_TEST_MODE=false
RESEND_OWNER_EMAIL=owner@example.com
SUPPORT_EMAIL=support@example.com
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret

# Cron Jobs (Vercel)
CRON_SECRET=your_random_cron_secret_here

# Web Push (notificações no navegador)
# Gerar com: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:suporte@corretorstudio.com.br
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Asaas Payment Gateway
ASAAS_API_KEY=aact_hmlg_your_sandbox_api_key
ASAAS_WALLET_ID=your_asaas_wallet_id
ASAAS_WEBHOOK_TOKEN=your_asaas_webhook_token
ASAAS_ENV=sandbox
ASAAS_URL=https://sandbox.asaas.com
ASAAS_URL_sandbox=https://sandbox.asaas.com

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_API_BASE_URL=/api/v1

# Encryption keys
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_server_encryption_key_64_hex
NEXT_PUBLIC_ENCRYPTION_KEY=your_public_encryption_key_64_hex

# Integrations (Meta / WhatsApp)
# Use 32 bytes key (64 hex) or base64 (44 chars)
INTEGRATIONS_ENCRYPTION_KEY=your_integrations_encryption_key
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=meta_lead_webhook_verify_token

# Google OAuth (Calendar + login local/remoto)
# Local: habilite em supabase/config.toml ([auth.external.google]) e adicione redirect
#   http://127.0.0.1:3000/auth/callback no Google Cloud Console.
# Após alterar config.toml: `supabase stop && supabase start` (ou reinicie `bun dev`).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Sentry (Error Tracking)
# DSN: Settings → Client Keys (DSN) in your Sentry project
NEXT_PUBLIC_SENTRY_DSN=https://your_public_key@o0.ingest.sentry.io/0
# Auth token: Settings → Auth Tokens in your Sentry org (write source maps scope)
# Also stored in .env.sentry-build-plugin for the Sentry build plugin
SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here

# WhatsApp — Evolution API
# `bun run dev` sobe Supabase + Evolution (docker-compose.evolution.yml) automaticamente.
# Copie .env.evolution.example → .env.evolution na primeira vez (ou o dev cria do example).
# `bun run dev` lê AUTHENTICATION_API_KEY de .env.evolution como EVO_API_KEY automaticamente.
# Sobrescreva aqui apenas se usar Evolution remota em dev:
# EVO_API_KEY=leadflow-local-evo-key
# URL base da instância Evolution API (sem barra final)
EVO_API_BASE_URL=http://127.0.0.1:8080
# URL que a Evolution (Docker) usa para chamar webhooks do app no host (dev local)
# Produção: omita — usa NEXT_PUBLIC_APP_URL
EVO_WEBHOOK_PUBLIC_URL=http://host.docker.internal:3000
