#!/usr/bin/env sh

set -eu

# Self-hosted runners reusam o workdir: um job com bun install liga os hooks;
# jobs posteriores (ex.: Open PR) fazem push sem node_modules e quebram no eslint.
if [ "${CI:-}" = "true" ]; then
  echo "[pre-push] CI=true — pulando validate:implementation (já coberto pelos jobs do workflow)."
  exit 0
fi

echo "[pre-push] Executando validação de implementação..."
if ! command -v bun >/dev/null 2>&1; then
  bun_directory="$HOME/.bun/bin"
  if [ -x "$bun_directory/bun" ]; then
    PATH="$bun_directory:$PATH"
    export PATH
  else
    echo "[pre-push] Bun não encontrado no PATH nem em $bun_directory/bun."
    exit 127
  fi
fi

exec bun run validate:implementation
