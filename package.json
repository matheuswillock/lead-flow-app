    "db:migrate:push:dry-run": "supabase db push --linked --dry-run",
    "db:migrate:status": "supabase migration list",
    "db:migrate:reset:local": "supabase db reset --local --no-seed",
    "db:clone:remote": "bunx tsx scripts/clone-remote-to-local.ts",
    "db:diff": "supabase db diff --schema public",
    "prisma:backfill-leadcode": "bunx tsx scripts/backfill-leadcode.ts",
