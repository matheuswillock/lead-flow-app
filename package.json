{
  "name": "lead-flow-app",
  "version": "0.292.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev-local.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "dev:clean": "bun scripts/clean-next-dev.ts && tsx scripts/dev-local.ts",
    "local:up": "docker compose -f docker-compose.local.yml up -d db",
    "local:up:hybrid": "docker compose -f docker-compose.local.yml --profile hybrid --env-file docker/local/.env.local-stack up -d",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "local:logs": "docker compose -f docker-compose.local.yml logs -f",
    "local:reset": "bun run local:up && PGSSLMODE=disable supabase db reset --db-url postgresql://postgres:postgres@127.0.0.1:55322/postgres --no-seed --yes",
    "docker:up": "bun run local:up",
    "docker:down": "bun run local:down",
    "evo:up": "docker compose -f docker-compose.evolution.yml --env-file .env.evolution up -d",
    "evo:down": "docker compose -f docker-compose.evolution.yml --env-file .env.evolution down",
    "evo:reset": "docker compose -f docker-compose.evolution.yml --env-file .env.evolution down -v && docker compose -f docker-compose.evolution.yml --env-file .env.evolution up -d",
    "evo:logs": "docker compose -f docker-compose.evolution.yml --env-file .env.evolution logs -f api",
    "evo:db:status": "supabase --workdir supabase-evolution migration list",
    "n8n:up": "docker compose -f docker-compose.n8n.yml --env-file .env.n8n up -d",
    "n8n:down": "docker compose -f docker-compose.n8n.yml --env-file .env.n8n down",
    "n8n:reset": "docker compose -f docker-compose.n8n.yml --env-file .env.n8n down -v && docker compose -f docker-compose.n8n.yml --env-file .env.n8n up -d",
    "n8n:logs": "docker compose -f docker-compose.n8n.yml --env-file .env.n8n logs -f n8n",
    "n8n:import": "bun scripts/n8n-import-workflows.ts",
    "n8n:import:all": "bun scripts/n8n-import-all-workflows.ts",
    "host:pack": "bun scripts/host-pack.ts",
    "vps:up": "bun scripts/vps-compose.ts up -d",
    "vps:down": "bun scripts/vps-compose.ts down",
    "vps:logs": "bun scripts/vps-compose.ts logs -f",
    "vps:ps": "bun scripts/vps-compose.ts ps",
    "ngrok": "bun scripts/ngrok-start.ts lead-flow",
    "ngrok:n8n": "bun scripts/ngrok-start.ts n8n",
    "build": "prisma generate && bun run build:sw && next build",
    "build:sw": "bun scripts/build-service-worker.ts",
    "start": "next start",
    "governance:sync": "bun scripts/ai-governance.ts sync-adapters",
    "governance:check": "bun scripts/ai-governance.ts check",
    "governance:check-api-masking": "bun scripts/ai-governance.ts check-api-masking",
    "governance:check-e2e-pages": "bun scripts/ai-governance.ts check-e2e-pages",
    "governance:warn-allowlist": "bun scripts/ai-governance.ts warn-allowlist",
    "validate:implementation": "bun run governance:sync && git diff --exit-code -- .github/copilot-instructions.md .cursor/rules/lead-flow-agents.mdc CLAUDE.md && bun run governance:check && bun run governance:check-e2e-pages && bun run governance:check-api-masking && bun run lint && bun run lint:pt-br:strict && bun run typecheck && bun run test:proxy",
    "hooks:install": "bun scripts/install-git-hooks.ts",
    "design:sync": "bun scripts/design/sync-tokens.ts",
    "design:check": "bun scripts/design/sync-tokens.ts --check",
    "skills:sync": "bun scripts/skills-sync.ts",
    "scaffold:feature": "bun scripts/scaffold-feature.ts",
    "typecheck": "bun run prisma:generate && tsc --noEmit",
    "lint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "lint:pt-br": "bun scripts/lint-pt-br.ts",
    "lint:pt-br:strict": "LINT_PT_BR_STRICT=1 bun scripts/lint-pt-br.ts",
    "test": "bun test --isolate --path-ignore-patterns 'e2e/**' --path-ignore-patterns '**/*.integration.test.ts' --path-ignore-patterns '**/*.spec.ts' --path-ignore-patterns 'deploy/**' --path-ignore-patterns '**/CampaignDispatchIndicator.test.tsx' --path-ignore-patterns 'app/api/v1/health-plans/route.test.ts' --path-ignore-patterns 'app/backoffice/(app)/cron-executions/**' --path-ignore-patterns '**/ContactsHook.import-flow.test.tsx' --path-ignore-patterns '**/AssociateBackofficeAccessUseCase.test.ts' --path-ignore-patterns '**/RadarRepository.mergeProfiles.test.ts' && bun run test:ui",
    "test:ui": "bun test --isolate --preload ./test/setup-happy-dom.ts \"app/backoffice/(app)/cron-executions\" \"./app/[supabaseId]/components/CampaignDispatchIndicator.test.tsx\" \"./app/[supabaseId]/components/TeamSwitchingScreen.test.tsx\" \"./app/[supabaseId]/email/campanhas/features/components/analytics/TrackingDegradedAlert.test.tsx\" \"./app/[supabaseId]/email/campanhas/features/components/CampaignDispatchProgressLine.test.tsx\" \"./app/[supabaseId]/email/campanhas/features/components/CampaignDispatchProgress.regression.test.tsx\" \"./app/[supabaseId]/email/campanhas/features/components/CampaignDispatchCountdownButtonLabel.test.tsx\" \"./app/[supabaseId]/email/campanhas/features/context/CampanhasHook.progress.test.ts\" \"./app/[supabaseId]/email/campanhas/features/context/campaign-dispatch-leaving-snapshot.test.ts\"",
    "test:backoffice-deletion": "bun test --isolate app/api/useCases/backofficeDeletion app/api/useCases/backofficeDatabaseBackup",
    "test:email": "bun test --isolate app/api/services/resend lib/email app/api/services/EmailCampaignDispatch app/api/services/EmailCredit app/api/services/email app/api/useCases/email",
    "test:proxy": "bun test proxy.test.ts lib/proxy/route-access.test.ts lib/supabase/auth-sessions.test.ts lib/supabase/realtime-guard.test.ts",
    "test:integration": "RADAR_INTEGRATION_TEST=1 MANAGER_USERS_INTEGRATION_TEST=1 bun test --isolate lib/radar/radar.integration.test.ts lib/account-users/manager-account-users.integration.test.ts",
    "test:integration:local": "bun run local:up && RADAR_INTEGRATION_TEST=1 MANAGER_USERS_INTEGRATION_TEST=1 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres bun run test:integration",
    "test:integration:email-domain": "EMAIL_DOMAIN_INTEGRATION_TEST=1 bun test --isolate app/api/infra/data/repositories/emailTeamSettings/EmailTeamSettingsRepository.sending-dns.integration.test.ts",
    "test:integration:email-domain:local": "bun run local:up && DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres bun run test:integration:email-domain",
    "test:integration:public-forms": "PUBLIC_FORMS_INTEGRATION_TEST=1 bun test --isolate app/api/infra/data/repositories/publicForms",
    "test:integration:public-forms:local": "bun run local:up && DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres bun run test:integration:public-forms",
    "test:integration:asaas-webhook": "ASAAS_WEBHOOK_INTEGRATION_TEST=1 bun test --isolate app/api/infra/data/repositories/asaasWebhook/processAsaasWebhookEvent.account-collision.integration.test.ts",
    "test:integration:asaas-webhook:local": "bun run local:up && DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres bun run test:integration:asaas-webhook",
    "test:aggregation": "METRIC_AGGREGATION_INTEGRATION_TEST=1 bun test --isolate app/api/infra/data/repositories/publicForms/metric-aggregation.integration.test.ts",
    "test:aggregation:local": "bun run local:up && METRIC_AGGREGATION_INTEGRATION_TEST=1 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres bun run test:aggregation",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:local": "E2E_REUSE_SERVER=1 playwright test",
    "format": "prettier --write .",
    "postinstall": "prisma generate && bun run hooks:install",
    "prisma:seed": "bunx prisma db seed",
    "db:seed:app": "bunx tsx prisma/seed-app.ts",
    "db:seed:backoffice": "bunx tsx prisma/seed-backoffice.ts",
    "db:seed:backoffice-products": "tsx prisma/seed-backoffice-products.ts",
    "db:seed:local": "tsx scripts/seed-local.ts",
    "db:seed:leads": "bunx tsx prisma/seed-leads.ts",
    "db:seed:e2e": "tsx scripts/seed-e2e.ts",
    "db:migrate:from-prisma": "bunx tsx scripts/db-migrate-from-prisma.ts",
    "db:migrate:new": "bunx tsx scripts/db-migrate-new.ts",
    "db:migrate:apply:local": "PGSSLMODE=disable supabase migration up --db-url postgresql://postgres:postgres@127.0.0.1:55322/postgres --yes",
    "db:migrate:push": "supabase db push --linked --include-all --yes",
    "db:migrate:push:dry-run": "supabase db push --linked --dry-run",
    "db:migrate:status": "supabase migration list",
    "db:migrate:reset:local": "PGSSLMODE=disable supabase db reset --db-url postgresql://postgres:postgres@127.0.0.1:55322/postgres --no-seed --yes",
    "db:backup": "bunx tsx scripts/backup-database.ts",
    "db:clone:remote": "tsx scripts/clone-remote-to-local.ts",
    "db:sync:backoffice-catalog": "bunx tsx scripts/db-sync-backoffice-catalog.ts",
    "db:diff": "supabase db diff --schema public",
    "prisma:backfill-leadcode": "bunx tsx scripts/backfill-leadcode.ts",
    "prisma:generate-import-leads-sql": "bunx tsx scripts/generate-backfill-import-leads.ts",
    "prisma:backfill-import-leads": "bunx tsx scripts/backfill-import-leads.ts",
    "prisma:import-onside-backstage-leads": "bunx tsx scripts/import-onside-backstage-leads.ts --confirm",
    "prisma:import-multiskill-noshow-leads": "bunx tsx scripts/import-multiskill-noshow-leads.ts --confirm",
    "prisma:backfill-teams": "bunx tsx scripts/backfill-teams.ts",
    "prisma:backfill-subscription-capacities": "bunx tsx scripts/backfill-subscription-capacities.ts",
    "prisma:backfill-waive-pending-add-user": "bunx tsx scripts/backfill-waive-pending-add-user.ts",
    "audit:fake-email-attribution-leads": "bunx tsx scripts/audit-fake-email-attribution-leads.ts",
    "reprocess:public-form-submissions": "bunx tsx scripts/reprocess-public-form-submissions.ts",
    "backfill:public-form-leads-ac": "bunx tsx scripts/backfill-public-form-leads-ac.ts",
    "backfill:form-viewed-attribution": "bunx tsx scripts/backfill-form-viewed-attribution.ts",
    "backfill:form-completed-occurred-at": "bunx tsx scripts/backfill-form-completed-occurred-at.ts",
    "recover:campaign-attribution-leads": "bunx tsx scripts/recover-campaign-attribution-leads.ts",
    "diagnose:stuck-campaign-dispatches": "bunx tsx scripts/diagnose-stuck-campaign-dispatches.ts",
    "recover:stuck-campaign-dispatches": "bunx tsx scripts/recover-stuck-campaign-dispatches.ts",
    "cleanup:fake-email-attribution-leads": "bunx tsx scripts/cleanup-fake-email-attribution-leads.ts",
    "prisma:migrate:status": "bunx prisma migrate status",
    "prisma:studio": "bunx prisma studio",
    "prisma:generate": "bunx prisma generate",
    "prisma:db:pull": "bunx prisma db pull",
    "prisma:db:push": "bunx prisma db push",
    "db:check": "bunx tsx check-database.ts",
    "admin:reset-karen-henrique": "bunx tsx scripts/admin/reset-karen-henrique.ts --confirm"
  },
