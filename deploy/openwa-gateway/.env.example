PORT=3333
OPENWA_API_KEY=<gerar com openssl rand -hex 32>
OPENWA_WEBHOOK_SECRET=<mesmo valor de OPENWA_WEBHOOK_SECRET no Vercel - min 32 chars>
SUPABASE_URL=https://<project-ref>.supabase.co
OPENWA_SUPABASE_KEY=<JWT scoped ao role openwa_storage, NAO a service-role key>
CHROMIUM_PATH=/usr/bin/chromium
NODE_ENV=production
