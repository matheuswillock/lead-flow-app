# Instalar em /etc/caddy/Caddyfile na VPS Hostinger.
# Caddy obtém certificados Let's Encrypt automaticamente para os subdomínios.
#
# Pré-requisitos DNS (registros A → IP da VPS):
#   ops.corretorstudio.com
#
# evo.corretorstudio.com e n8n.corretorstudio.com removidos — Evolution/N8N
# não rodam mais nesta VPS (ver docker-compose.vps.yml).

ops.corretorstudio.com {
	reverse_proxy 127.0.0.1:9090
}
