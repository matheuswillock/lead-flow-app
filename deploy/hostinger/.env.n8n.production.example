# Espelho de produção — N8N na VPS (/opt/lead-flow-bot/.env.n8n)
# Preferir preencher via painel Bethânia → Ops / Host (apply env).

N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto
N8N_RUNNERS_ENABLED=false

LEAD_FLOW_API_BASE_URL=https://app.corretorstudio.com
N8N_WEBHOOK_BASE_URL=http://n8n:5678

BACKOFFICE_STUDIO_BOT_WEBHOOK_SECRET=<mesmo valor da Vercel>

EVO_API_BASE_URL=http://evolution_api:8080
EVO_API_KEY=<AUTHENTICATION_API_KEY do container evolution>
EVO_BETHANIA_INSTANCE=bethania
BACKOFFICE_BETHANIA_WHATSAPP_NUMBER=5511XXXXXXXXX

BETHANIA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
