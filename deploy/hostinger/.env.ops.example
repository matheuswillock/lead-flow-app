# Token do agente Ops (mesmo valor configurado no backoffice após rotate-token).
# Também deve existir em Vercel Production como BACKOFFICE_STUDIO_BOT_OPS_AGENT_TOKEN.
OPS_AGENT_TOKEN=

# Backup diário (pg_dump) — Bearer-only em /backup/run e /backup/download
# Em Vercel (opcional — se omitidos, usa defaults):
#   BACKUP_VPS_WEBHOOK_URL=https://ops.corretorstudio.com/backup/run
#   BACKUP_VPS_TOKEN=<mesmo OPS_AGENT_TOKEN>
# Fallback de token: BACKOFFICE_STUDIO_BOT_OPS_AGENT_TOKEN
# Fallback de URL: https://ops.corretorstudio.com/backup/run
BACKUP_ROOT=/opt/lead-flow-app/backups
BACKUP_DATABASE_URL=
BACKUP_SCRIPT_PATH=/opt/lead-flow-app/deploy/hostinger/backup-supabase.sh
BACKUP_RETENTION_DAYS=14

