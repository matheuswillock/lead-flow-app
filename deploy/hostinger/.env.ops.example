# Token do agente Ops (mesmo valor configurado no backoffice após rotate-token).
# Também deve existir em Vercel Production como BACKOFFICE_STUDIO_BOT_OPS_AGENT_TOKEN.
# Arquivo na VPS: /opt/lead-flow-bot/.env.ops — após editar: docker compose -f docker-compose.vps.yml up -d --force-recreate studio-bot-ops
# Teste: curl -sS -H "Authorization: Bearer $TOKEN" https://ops.corretorstudio.com/v1/token/verify
OPS_AGENT_TOKEN=

# Backup diário (pg_dump) — Bearer-only em /backup/run e /backup/download
# Obrigatório para backup manual/cron funcionar na VPS:
# Use a connection string DIRECT do Supabase (porta 5432, não pooler 6543).
BACKUP_DATABASE_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
BACKUP_ROOT=/opt/lead-flow-app/backups
# No container studio-bot-ops o script padrão é /app/backup-supabase.sh (imagem).
BACKUP_SCRIPT_PATH=/app/backup-supabase.sh
BACKUP_RETENTION_DAYS=14

# Em Vercel (opcional — se omitidos, usa defaults):
#   BACKUP_VPS_WEBHOOK_URL=https://ops.corretorstudio.com/backup/run
#   BACKUP_VPS_TOKEN=<mesmo OPS_AGENT_TOKEN>

