# =============================================================================
# .env.test.example — ambiente Playwright / `next start` com APP_ENV=test
# =============================================================================
#
# Copie para `.env.test` (gitignored). Não use chaves de produção.
#
# Seed:
#   bun run db:seed:e2e
#
# =============================================================================

APP_ENV=test
E2E_TEST_MODE=true
# 64 hex — gerar com: openssl rand -hex 32
E2E_JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Supabase (placeholders — Auth E2E não usa o projeto remoto)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=e2e-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=e2e-supabase-service-role-key-placeholder
SUPABASE_LEAD_ATTACHMENTS_BUCKET=lead-attachments
SUPABASE_PROFILE_ICONS_BUCKET=profile-icons
SUPABASE_EMAIL_TEMPLATE_ASSETS_BUCKET=email-template-assets
SUPABASE_SUPPORT_ATTACHMENTS_BUCKET=support-request-attachments

# Database PostgreSQL local (docker-compose.local.yml :55322)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55322
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Resend
RESEND_API_KEY=re_e2e_test_placeholder_not_a_real_key
EMAIL_TEST_MODE=true
RESEND_OWNER_EMAIL=e2e.owner@example.com

# Slack
SLACK_SUPPORT_WEBHOOK_URL=https://hooks.slack.com/services/e2e/test/placeholder
SLACK_BACKOFFICE_LEADS_WEBHOOK_URL=https://hooks.slack.com/services/e2e/test/backoffice-leads

# Asaas — SOMENTE sandbox. Nunca chave de produção. (conta "primary")
ASAAS_API_KEY=aact_hmlg_e2e_sandbox_placeholder_key
ASAAS_WALLET_ID=e2e-asaas-wallet-placeholder
ASAAS_WEBHOOK_TOKEN=e2e-asaas-webhook-token-placeholder
ASAAS_ENV=sandbox
ASAAS_URL=https://sandbox.asaas.com
ASAAS_URL_sandbox=https://sandbox.asaas.com
# Lida só por assertAsaasSandbox() (e2e/support/asaas.ts) — sem ela a guarda
# cai no fallback de ASAAS_API_KEY.
ASAAS_SANDBOX_API_KEY=aact_hmlg_e2e_sandbox_placeholder_key

# Asaas — conta "legacy" (antiga). Vazias por padrão (pré-cutover); specs que
# testam o caminho legacy MUST preencher as duas com valores de sandbox.
ASAAS_LEGACY_API_KEY=
ASAAS_LEGACY_WEBHOOK_TOKEN=
ASAAS_LEGACY_SANDBOX_API_KEY=

# Checkouts hospedados Asaas (/c/...) de créditos de e-mail — placeholder
# suficiente para e2e/specs/public/adquirir/creditos.spec.ts (nunca abre a
# página Asaas de fato, só valida a montagem do Output/checkoutUrl).
ASAAS_CREDIT_CHECKOUT_ID_25K=e2e-checkout-25k-placeholder
ASAAS_CREDIT_CHECKOUT_ID_50K=e2e-checkout-50k-placeholder

# App URLs
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_API_BASE_URL=/api/v1

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Encryption keys (64 hex). Gerar com: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NEXT_PUBLIC_ENCRYPTION_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Integrations
INTEGRATIONS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
META_VERIFY_TOKEN=e2e-meta-verify-token-placeholder

# OpenWA Gateway
OPENWA_API_URL=http://127.0.0.1:3333
OPENWA_API_KEY=e2e-openwa-api-key-placeholder
OPENWA_WEBHOOK_SECRET=e2e-openwa-webhook-secret-min-32-chars-xx
