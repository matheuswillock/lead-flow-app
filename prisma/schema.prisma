// -----------------------------
// PROFILE USER TYPE (Comum / Member PRO)
// Lookup table with the user type tiers, plus a 1:1 assignment table
// linking each Profile to its current type (cascades from Profile).
// -----------------------------

model ProfileUserType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique @db.Text
  name        String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  assignments ProfileUserTypeAssignment[]

  @@map("profile_user_types")
}

model ProfileUserTypeAssignment {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId           String    @unique @db.Uuid
  userTypeId          String    @db.Uuid
  accessStartsAt      DateTime? @db.Timestamptz(6)
  accessExpiresAt     DateTime? @db.Timestamptz(6)
  assignedByProfileId String?   @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  profile     Profile         @relation("ProfileUserTypeAssignment", fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "profile_user_type_assignments_profile_id_fkey")
  userType    ProfileUserType @relation(fields: [userTypeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "profile_user_type_assignments_user_type_id_fkey")
  assignedBy  Profile?        @relation("ProfileUserTypeAssignmentAssignedBy", fields: [assignedByProfileId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "profile_user_type_assignments_assigned_by_profile_id_fkey")

  @@index([userTypeId])
  @@index([accessExpiresAt])
  @@map("profile_user_type_assignments")
}

// ==============================
// WHATSAPP MODULE
// ==============================

enum WhatsAppProvider {
  EVOLUTION
}

enum WhatsAppConnectionStatus {
  PENDING
  QR_READY
  CONNECTED
  DISCONNECTED
  ERROR
  BANNED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
  UNKNOWN
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum WhatsAppUsageEventType {
  OUTBOUND_MESSAGE
  INBOUND_MESSAGE
  CONNECTION_EVENT
  RECONNECTION_EVENT
}

enum WhatsAppHistorySyncStatus {
  IDLE
  RUNNING
  COMPLETED
  FAILED
}

enum WhatsAppHandoffMode {
  BOT
  HUMAN
}

enum WhatsAppContactNameSource {
  MANUAL
  LEAD
  PHONE_BOOK
  PUSH_NAME
}

enum WhatsAppAutoResponseRuleType {
  WELCOME
  OFF_HOURS
  KEYWORD
}

enum WhatsAppAutoResponseMatchMode {
  CONTAINS
  EXACT
  STARTS_WITH
}

enum TeamWhatsAppContactSource {
  PHONE_CONTACTS
  GROUP_PARTICIPANT
}

model TeamWhatsAppContact {
  id           String                    @id @default(uuid()) @db.Uuid
  teamId       String                    @db.Uuid
  remoteJid    String                    @db.Text
  opaqueId     String                    @db.Text
  phoneNumber  String?                   @db.Text
  displayName  String?                   @db.Text
  pushName     String?                   @db.Text
  source       TeamWhatsAppContactSource
  lastSyncedAt DateTime                  @default(now()) @db.Timestamptz(6)
  createdAt    DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                  @updatedAt @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, remoteJid])
  @@index([teamId, opaqueId])
  @@map("team_whatsapp_contacts")
}

model TeamWhatsAppConfig {
  id                 String                   @id @default(uuid()) @db.Uuid
  teamId             String                   @unique @db.Uuid
  provider           WhatsAppProvider         @default(EVOLUTION)
  instanceName       String                   @db.Text
  instanceId         String?                  @db.Text
  phoneNumber        String?                  @db.Text
  normalizedPhone    String?                  @db.Text
  primaryConfigId    String?                  @db.Uuid
  displayName        String?                  @db.Text
  status             WhatsAppConnectionStatus @default(PENDING)
  qrCodeText         String?                  @db.Text
  qrCodeImageUrl     String?                  @db.Text
  webhookSecret      String                   @db.Text
  hostBaseUrl        String?                  @db.Text
  lastConnectedAt    DateTime?                @db.Timestamptz(6)
  lastDisconnectedAt DateTime?                @db.Timestamptz(6)
  lastSyncAt             DateTime?                @db.Timestamptz(6)
  historySyncStatus      WhatsAppHistorySyncStatus @default(IDLE)
  historySyncStartedAt   DateTime?                @db.Timestamptz(6)
  historySyncCompletedAt DateTime?                @db.Timestamptz(6)
  historySyncError       String?                  @db.Text
  usageLimitMonthly      Int                      @default(2000)
  billingEnabled     Boolean                  @default(true)
  webhookConsecutiveFailures Int                @default(0)
  createdByProfileId String                   @db.Uuid
  updatedByProfileId String                   @db.Uuid
  createdAt          DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(6)

  team          Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy     Profile                @relation("WhatsAppConfigCreatedBy", fields: [createdByProfileId], references: [id])
  updatedBy     Profile                @relation("WhatsAppConfigUpdatedBy", fields: [updatedByProfileId], references: [id])
  primaryConfig TeamWhatsAppConfig?    @relation("WhatsAppConfigPrimary", fields: [primaryConfigId], references: [id], onDelete: SetNull)
  mirroredConfigs TeamWhatsAppConfig[] @relation("WhatsAppConfigPrimary")
  conversations WhatsAppConversation[]
  usageEvents   WhatsAppUsageEvent[]
  messages      WhatsAppMessage[]
  autoResponseRules WhatsAppAutoResponseRule[]

  @@index([normalizedPhone])
  @@index([primaryConfigId])
  @@index([webhookSecret])
  @@index([instanceName])
  @@map("team_whatsapp_configs")
}

model WhatsAppConversation {
  id                 String    @id @default(uuid()) @db.Uuid
  teamId             String    @db.Uuid
  configId           String    @db.Uuid
  leadId             String?   @db.Uuid
  externalChatId     String?   @db.Text
  contactPhone       String    @db.Text
  contactName        String?   @db.Text
  contactNameSource  WhatsAppContactNameSource @default(PUSH_NAME)
  contactAvatarUrl   String?   @db.Text
  normalizedPhone    String    @db.Text
  assignedProfileId  String?   @db.Uuid
  createdByProfileId String?   @db.Uuid
  lastMessageAt      DateTime? @db.Timestamptz(6)
  lastInboundAt      DateTime? @db.Timestamptz(6)
  lastOutboundAt     DateTime? @db.Timestamptz(6)
  lastMessagePreview String?   @db.Text
  unreadCount        Int       @default(0)
  isArchived         Boolean   @default(false)
  handoffMode        WhatsAppHandoffMode @default(BOT)
  welcomeSentAt      DateTime? @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  team            Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  config          TeamWhatsAppConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  lead            Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedProfile Profile?           @relation("WhatsAppConversationAssignee", fields: [assignedProfileId], references: [id], onDelete: SetNull)
  createdByProfile Profile?          @relation("WhatsAppConversationCreator", fields: [createdByProfileId], references: [id], onDelete: SetNull)
  messages        WhatsAppMessage[]
  autoResponseLogs WhatsAppAutoResponseLog[]
  tagAssignments  WhatsAppConversationTagAssignment[]

  @@unique([configId, externalChatId])
  @@index([teamId, lastMessageAt(sort: Desc)])
  @@index([teamId, isArchived, lastMessageAt(sort: Desc)])
  @@index([teamId, normalizedPhone])
  @@index([leadId])
  @@index([assignedProfileId])
  @@index([createdByProfileId])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id                String                   @id @default(uuid()) @db.Uuid
  conversationId    String                   @db.Uuid
  teamId            String                   @db.Uuid
  configId          String                   @db.Uuid
  leadId            String?                  @db.Uuid
  providerMessageId String?                  @db.Text
  providerEventId   String?                  @db.Text
  direction         WhatsAppMessageDirection
  messageType       WhatsAppMessageType      @default(TEXT)
  status            WhatsAppMessageStatus    @default(PENDING)
  contentText       String?                  @db.Text
  mediaUrl          String?                  @db.Text
  mediaMimeType     String?                  @db.Text
  mediaFileName     String?                  @db.Text
  linkPreview       Json?
  caption           String?                  @db.Text
  senderDisplayName String?                  @db.Text
  sentByProfileId   String?                  @db.Uuid
  senderPhone       String?                  @db.Text
  recipientPhone    String?                  @db.Text
  sentAt            DateTime?                @db.Timestamptz(6)
  deliveredAt       DateTime?                @db.Timestamptz(6)
  readAt            DateTime?                @db.Timestamptz(6)
  failedAt          DateTime?                @db.Timestamptz(6)
  isAutoResponse    Boolean                  @default(false)
  autoResponseRuleId String?                 @db.Uuid
  rawPayload        Json
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(6)

  conversation  WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  team          Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  config        TeamWhatsAppConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)
  lead          Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sentByProfile Profile?             @relation("WhatsAppMessageSentBy", fields: [sentByProfileId], references: [id], onDelete: SetNull)
  autoResponseRule WhatsAppAutoResponseRule? @relation(fields: [autoResponseRuleId], references: [id], onDelete: SetNull)

  @@unique([teamId, providerMessageId])
  @@unique([teamId, providerEventId])
  @@index([conversationId, createdAt(sort: Asc)])
  @@index([sentByProfileId])
  @@map("whatsapp_messages")
}

model WhatsAppUsageEvent {
  id                  String                    @id @default(uuid()) @db.Uuid
  teamId              String                    @db.Uuid
  configId            String                    @db.Uuid
  conversationId      String?                   @db.Uuid
  messageId           String?                   @db.Uuid
  providerMessageId   String?                   @db.Text
  periodKey           String                    @db.Text
  provider            WhatsAppProvider          @default(EVOLUTION)
  eventType           WhatsAppUsageEventType
  direction           WhatsAppMessageDirection?
  billable            Boolean                   @default(false)
  countedTowardsQuota Boolean                   @default(true)
  quantity            Int                       @default(1)
  rawPayload          Json?
  createdAt           DateTime                  @default(now()) @db.Timestamptz(6)

  team   Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  config TeamWhatsAppConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([teamId, providerMessageId, eventType])
  @@index([teamId, periodKey])
  @@index([configId, periodKey])
  @@index([teamId, eventType, createdAt(sort: Desc)])
  @@map("whatsapp_usage_events")
}

model WhatsAppAutoResponseRule {
  id               String                        @id @default(uuid()) @db.Uuid
  configId         String                        @db.Uuid
  type             WhatsAppAutoResponseRuleType
  replyMessage     String                        @db.Text
  triggerKeywords  String[]                      @default([])
  matchMode        WhatsAppAutoResponseMatchMode @default(CONTAINS)
  offHoursSchedule Json?
  isActive         Boolean                       @default(false)
  priority         Int                           @default(0)
  createdAt        DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                      @updatedAt @db.Timestamptz(6)

  config   TeamWhatsAppConfig        @relation(fields: [configId], references: [id], onDelete: Cascade)
  messages WhatsAppMessage[]
  logs     WhatsAppAutoResponseLog[]

  @@index([configId, type, isActive])
  @@map("whatsapp_auto_response_rules")
}

model WhatsAppAutoResponseLog {
  id                String                     @id @default(uuid()) @db.Uuid
  conversationId    String                     @db.Uuid
  ruleId            String?                    @db.Uuid
  ruleType          WhatsAppAutoResponseRuleType
  inboundMessageId  String?                    @db.Uuid
  outboundMessageId String?                    @db.Uuid
  triggerText       String?                    @db.Text
  sentText          String                     @db.Text
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)

  conversation WhatsAppConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  rule         WhatsAppAutoResponseRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([conversationId, ruleType, inboundMessageId], map: "whatsapp_auto_response_logs_conv_rule_inbound_key")
  @@index([conversationId, ruleType, createdAt])
  @@map("whatsapp_auto_response_logs")
}

model WhatsAppConversationTag {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  name      String   @db.Text
  color     String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  team        Team                               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignments WhatsAppConversationTagAssignment[]

  @@unique([teamId, name])
  @@index([teamId, sortOrder])
  @@map("whatsapp_conversation_tags")
}

model WhatsAppConversationTagAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  tagId          String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  conversation WhatsAppConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          WhatsAppConversationTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([conversationId, tagId])
  @@index([tagId])
  @@map("whatsapp_conversation_tag_assignments")
}

// ==============================
// CDP (Customer Data Platform)
// ==============================

enum CustomerIdentityType {
  phone
  email
  document
  lead_id
  email_contact_id
  portfolio_id
  whatsapp_contact_id

  @@map("customer_identity_type")
}

enum CustomerSourceType {
  crm_lead
  portfolio
  email_contact
  email_campaign
  whatsapp_contact

  @@map("customer_source_type")
}

enum CustomerChannel {
  email
  whatsapp

  @@map("customer_channel")
}

enum CustomerConsentStatus {
  allowed
  blocked
  unknown

  @@map("customer_consent_status")
}

enum CustomerConsentReason {
  manual
  imported
  unsubscribe
  bounce
  complaint
  opt_out
  missing_identity

  @@map("customer_consent_reason")
}

enum EmailVariableValueSource {
  STATIC
  CDP

  @@map("email_variable_value_source")
}

model CustomerProfile {
  id                       String    @id @default(uuid()) @db.Uuid
  teamId                   String    @db.Uuid
  normalizedName           String    @db.Text
  displayName              String    @db.Text
  normalizedPhone          String    @db.Text
  displayPhone             String    @db.Text
  primaryEmail             String?   @db.Text
  normalizedPrimaryEmail   String?   @db.Text
  primaryDocument          String?   @db.Text
  normalizedPrimaryDocument String?  @db.Text
  lastSeenAt               DateTime? @db.Timestamptz(6)
  profileData              Json?
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)

  team       Team                      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  identities CustomerIdentity[]
  sourceLinks CustomerSourceLink[]
  events     CustomerEvent[]
  consents   CustomerChannelConsent[]

  @@unique([teamId, normalizedPhone, normalizedName])
  @@index([teamId, normalizedPrimaryEmail])
  @@index([teamId, normalizedPrimaryDocument])
  @@index([teamId, lastSeenAt(sort: Desc)])
  @@map("corretor_studio_cdp_profiles")
}

model CustomerIdentity {
  id              String               @id @default(uuid()) @db.Uuid
  profileId       String               @db.Uuid
  teamId          String               @db.Uuid
  type            CustomerIdentityType
  value           String?              @db.Text
  normalizedValue String               @db.Text
  source          String               @db.Text
  isPrimary       Boolean              @default(false)
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)

  profile CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, type, normalizedValue])
  @@index([profileId, type])
  @@map("corretor_studio_cdp_identities")
}

model CustomerSourceLink {
  id             String             @id @default(uuid()) @db.Uuid
  profileId      String             @db.Uuid
  teamId         String             @db.Uuid
  sourceType     CustomerSourceType
  sourceId       String             @db.Text
  sourceMetadata Json?
  firstLinkedAt  DateTime           @default(now()) @db.Timestamptz(6)
  lastSyncedAt   DateTime           @default(now()) @db.Timestamptz(6)

  profile CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, sourceType, sourceId])
  @@index([profileId, sourceType])
  @@map("corretor_studio_cdp_source_links")
}

model CustomerEvent {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @db.Uuid
  teamId     String   @db.Uuid
  eventType  String   @db.Text
  sourceType String   @db.Text
  sourceId   String?  @db.Text
  occurredAt DateTime @db.Timestamptz(6)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  profile CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, sourceType, sourceId, eventType, occurredAt])
  @@index([teamId, eventType, occurredAt(sort: Desc)])
  @@index([profileId, occurredAt(sort: Desc)])
  @@map("corretor_studio_cdp_events")
}

model CustomerChannelConsent {
  id         String                @id @default(uuid()) @db.Uuid
  profileId  String                @db.Uuid
  teamId     String                @db.Uuid
  channel    CustomerChannel
  status     CustomerConsentStatus @default(unknown)
  reason     CustomerConsentReason?
  sourceType String?               @db.Text
  sourceId   String?               @db.Text
  updatedAt  DateTime              @updatedAt @db.Timestamptz(6)
  createdAt  DateTime              @default(now()) @db.Timestamptz(6)

  profile CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([profileId, channel])
  @@index([teamId, channel, status])
  @@map("corretor_studio_cdp_channel_consents")
}

// ==============================
// STUDIO BOT (BETHÂNIA) — BACKOFFICE
// ==============================

enum BackofficeBotChannelType {
  whatsapp

  @@map("backoffice_bot_channel_type")
}

enum BackofficeBotChannelStatus {
  pending
  connected
  disconnected
  error

  @@map("backoffice_bot_channel_status")
}

enum BackofficeBotAuthChallengeSource {
  channel_email
  web_otp

  @@map("backoffice_bot_auth_challenge_source")
}

enum BackofficeBotAuthChallengeStatus {
  pending
  verified
  expired
  failed

  @@map("backoffice_bot_auth_challenge_status")
}

enum BackofficeBotUserLinkSource {
  channel_email
  web_otp

  @@map("backoffice_bot_user_link_source")
}

enum BackofficeBotMessageDirection {
  inbound
  outbound

  @@map("backoffice_bot_message_direction")
}

enum BackofficeBotEventOutboxStatus {
  pending
  sent
  failed

  @@map("backoffice_bot_event_outbox_status")
}

model BackofficeBotChannel {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName       String                     @default("Bethânia") @db.Text
  avatarUrl         String?                    @db.Text
  avatarStoragePath String?                    @db.Text
  aboutText         String?                    @db.Text
  phoneNumber       String?                    @db.Text
  lastProfileSyncAt DateTime?                  @db.Timestamptz(6)
  channelType       BackofficeBotChannelType   @default(whatsapp)
  status            BackofficeBotChannelStatus @default(pending)
  providerConfig    Json?
  webhookSecret     String                     @db.Text
  n8nInboundUrl     String?                    @db.Text
  n8nOutboundSecret String                     @db.Text
  isActive          Boolean                    @default(true)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(6)

  messages BackofficeBotMessage[]

  @@map("backoffice_bot_channels")
}

model BackofficeBotAuthChallenge {
  id              String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source          BackofficeBotAuthChallengeSource
  normalizedPhone String?                          @db.Text
  emailRequested  String?                          @db.Text
  profileId       String?                          @db.Uuid
  codeHash        String                           @db.Text
  status          BackofficeBotAuthChallengeStatus @default(pending)
  attemptCount    Int                              @default(0)
  expiresAt       DateTime                         @db.Timestamptz(6)
  verifiedAt      DateTime?                        @db.Timestamptz(6)
  ipMetadata      Json?
  createdAt       DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                         @updatedAt @db.Timestamptz(6)

  profile  Profile?              @relation(fields: [profileId], references: [id], onDelete: SetNull)
  userLink BackofficeBotUserLink?

  @@index([normalizedPhone, status])
  @@index([profileId, createdAt(sort: Desc)])
  @@map("backoffice_bot_auth_challenges")
}

model BackofficeBotUserLink {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId         String                      @db.Uuid
  normalizedPhone   String                      @db.Text
  linkedAt          DateTime                    @default(now()) @db.Timestamptz(6)
  linkedBy          BackofficeBotUserLinkSource
  authChallengeId   String?                     @unique @db.Uuid
  isActive          Boolean                     @default(true)
  lastInteractionAt DateTime?                   @db.Timestamptz(6)
  revokedAt         DateTime?                   @db.Timestamptz(6)
  createdAt         DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                    @updatedAt @db.Timestamptz(6)

  profile       Profile                     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  authChallenge BackofficeBotAuthChallenge? @relation(fields: [authChallengeId], references: [id], onDelete: SetNull)
  sessions      BackofficeBotSession[]
  messages      BackofficeBotMessage[]

  @@index([profileId])
  @@index([normalizedPhone, isActive])
  @@map("backoffice_bot_user_links")
}

model BackofficeBotSession {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userLinkId    String   @db.Uuid
  teamId        String   @db.Uuid
  currentLeadId String?  @db.Uuid
  flowId        String?  @db.Text
  flowStep      String?  @db.Text
  flowStack     Json     @default("[]")
  expiresAt     DateTime @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  userLink BackofficeBotUserLink @relation(fields: [userLinkId], references: [id], onDelete: Cascade)
  team     Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userLinkId, expiresAt])
  @@map("backoffice_bot_sessions")
}

model BackofficeBotMessage {
  id               String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId        String                        @db.Uuid
  userLinkId       String?                       @db.Uuid
  direction        BackofficeBotMessageDirection
  channelMessageId String?                       @unique @db.Text
  flowId           String?                       @db.Text
  errorCode        String?                       @db.Text
  payload          Json
  createdAt        DateTime                      @default(now()) @db.Timestamptz(6)

  channel  BackofficeBotChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userLink BackofficeBotUserLink?  @relation(fields: [userLinkId], references: [id], onDelete: SetNull)

  @@index([userLinkId, createdAt(sort: Desc)])
  @@index([channelId, createdAt(sort: Desc)])
  @@map("backoffice_bot_messages")
}

model BackofficeBotNotificationPreference {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId  String   @db.Uuid
  type       String   @db.Text
  enabled    Boolean  @default(true)
  quietHours Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type])
  @@map("backoffice_bot_notification_preferences")
}

model BackofficeBotEventOutbox {
  id             String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType      String                         @db.Text
  profileId      String                         @db.Uuid
  payload        Json
  status         BackofficeBotEventOutboxStatus @default(pending)
  idempotencyKey String                         @unique @db.Text
  createdAt      DateTime                       @default(now()) @db.Timestamptz(6)
  sentAt         DateTime?                      @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([profileId, createdAt(sort: Desc)])
  @@map("backoffice_bot_event_outbox")
}

model AsaasWebhookEvent {
  id           String                  @id @db.Text
  eventType    String?                 @map("eventType") @db.Text
  payload      Json
  status       AsaasWebhookEventStatus @default(pending)
  errorMessage String?                 @map("errorMessage") @db.Text
  receivedAt   DateTime                @default(now()) @map("receivedAt") @db.Timestamptz(6)
  processedAt  DateTime?               @map("processedAt") @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @map("updatedAt") @db.Timestamptz(6)

  @@index([status, receivedAt(sort: Desc)], map: "asaas_webhook_events_status_received_at_idx")
  @@map("asaas_webhook_events")
}
