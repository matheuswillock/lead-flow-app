// -----------------------------
// BACKOFFICE PRODUCTS & SUBSCRIPTIONS
// -----------------------------

model BackofficeProduct {
  id              String                       @id @default(uuid()) @db.Uuid
  name            String                       @db.Text
  slug            String                       @unique @db.Text
  description     String?                      @db.Text
  type            BackofficeProductType
  billingMode     BackofficeProductBillingMode @default(RECURRING)
  priceMonthly    Decimal?                     @db.Decimal(10, 2)
  priceQuarterly  Decimal?                     @db.Decimal(10, 2)
  priceSemiannual Decimal?                     @db.Decimal(10, 2)
  priceAnnual     Decimal?                     @db.Decimal(10, 2)
  priceLifetime   Decimal?                     @db.Decimal(10, 2)
  isActive        Boolean                      @default(true)
  createdAt       DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                     @updatedAt @db.Timestamptz(6)

  paymentRules         BackofficeProductPaymentRule[]
  userSubscriptions    BackofficeUserSubscription[]
  profileSubscriptions ProfileSubscription[]
  features             BackofficeFeature[]

  @@index([slug])
  @@index([type, isActive])
  @@map("backoffice_products")
}

model BackofficeFeature {
  id                    String                       @id @default(uuid()) @db.Uuid
  slug                  String                       @unique @db.Text
  name                  String                       @db.Text
  description           String?                      @db.Text
  parentId              String?                      @db.Uuid
  productSlug           String?                      @db.Text
  accessMode            BackofficeFeatureAccessMode  @default(PUBLIC)
  defaultAccessLevel    BackofficeFeatureAccessLevel @default(FULL)
  betaEnabled           Boolean                      @default(false)
  inheritParentSettings Boolean                      @default(false)
  isActive              Boolean                      @default(true)
  sortOrder             Int                          @default(0)
  createdAt             DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                     @updatedAt @db.Timestamptz(6)

  parent      BackofficeFeature?            @relation("BackofficeFeatureTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    BackofficeFeature[]           @relation("BackofficeFeatureTree")
  product     BackofficeProduct?            @relation(fields: [productSlug], references: [slug], onDelete: SetNull)
  grants      BackofficeFeatureGrant[]
  accessRules BackofficeFeatureAccessRule[]

  @@index([parentId], map: "backoffice_features_parent_id_idx")
  @@index([productSlug], map: "backoffice_features_product_slug_idx")
  @@index([isActive, sortOrder], map: "backoffice_features_active_sort_idx")
  @@map("backoffice_features")
}

model BackofficeFeatureAccessRule {
  id          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  featureId   String                       @db.Uuid
  principal   BackofficeAccessPrincipal
  accessLevel BackofficeFeatureAccessLevel
  createdAt   DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                     @updatedAt @db.Timestamptz(6)

  feature BackofficeFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, principal], map: "backoffice_feature_access_rules_feature_principal_key")
  @@index([featureId], map: "backoffice_feature_access_rules_feature_id_idx")
  @@map("backoffice_feature_access_rules")
}

model BackofficeFeatureGrant {
  id          String                       @id @default(uuid()) @db.Uuid
  featureId   String                       @db.Uuid
  profileId   String                       @db.Uuid
  grantType   BackofficeFeatureGrantType   @default(BETA)
  accessLevel BackofficeFeatureAccessLevel @default(FULL)
  isActive    Boolean                      @default(true)
  createdAt   DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                     @updatedAt @db.Timestamptz(6)

  feature BackofficeFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  profile Profile           @relation("BackofficeFeatureProfileGrants", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([featureId, profileId, grantType], map: "backoffice_feature_grants_feature_profile_grant_type_key")
  @@index([profileId, grantType, isActive], map: "backoffice_feature_grants_profile_grant_type_active_idx")
  @@index([featureId, isActive], map: "backoffice_feature_grants_feature_active_idx")
  @@map("backoffice_feature_grants")
}

model BackofficeProductPaymentRule {
  id              String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String                         @db.Uuid
  paymentMethod   BackofficePaymentMethod
  billingCycle    BackofficeAdhesionBillingCycle
  price           Decimal                        @db.Decimal(10, 2)
  canInstallment  Boolean                        @default(false)
  maxInstallments Int                            @default(1)
  createdAt       DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)

  product BackofficeProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "backoffice_product_payment_rules_productid_fkey")

  @@unique([productId, paymentMethod, billingCycle], map: "backoffice_product_payment_rules_unique")
  @@index([productId], map: "backoffice_product_payment_rules_productid_idx")
  @@map("backoffice_product_payment_rules")
}

model BackofficeUserSubscription {
  id         String                          @id @default(uuid()) @db.Uuid
  profileId  String                          @db.Uuid
  productId  String                          @db.Uuid
  status     BackofficeSubscriptionStatus    @default(active)
  cycle      BackofficeAdhesionBillingCycle?
  startDate  DateTime                        @db.Timestamptz(6)
  endDate    DateTime?                       @db.Timestamptz(6)
  adhesionId String?                         @db.Uuid
  createdAt  DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime                        @updatedAt @db.Timestamptz(6)

  profile Profile           @relation("BackofficeUserSubscriptions", fields: [profileId], references: [id], onDelete: Cascade)
  product BackofficeProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([profileId, productId], map: "backoffice_user_subscriptions_profile_id_product_id_key")
  @@index([profileId, status])
  @@index([productId])
  @@index([adhesionId])
  @@map("backoffice_user_subscriptions")
}

// -----------------------------
// PROFILE SUBSCRIPTION (public.profile_subscriptions)
// One record per master Profile. Operators inherit via Profile.managerId.
// -----------------------------

model ProfileSubscription {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId                String              @unique @db.Uuid
  adhesionId               String?             @unique @db.Uuid
  productId                String?             @db.Uuid
  asaasSubscriptionId      String?             @db.Text
  asaasInstallmentId       String?             @db.Text
  subscriptionStatus       SubscriptionStatus?
  subscriptionPlan         SubscriptionPlan?
  subscriptionStartDate    DateTime?           @db.Timestamptz(6)
  subscriptionEndDate      DateTime?           @db.Timestamptz(6)
  trialEndDate             DateTime?           @db.Timestamptz(6)
  subscriptionNextDueDate  DateTime?           @db.Timestamptz(6)
  subscriptionCycle        String?             @db.Text
  subscriptionLastSyncedAt DateTime?           @db.Timestamptz(6)
  hasPermanentSubscription Boolean             @default(false)
  createdAt                DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  profile  Profile                      @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "profile_subscriptions_profileId_fkey")
  adhesion BackofficeAdhesion?          @relation(fields: [adhesionId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "profile_subscriptions_adhesionId_fkey")
  product  BackofficeProduct?           @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "profile_subscriptions_productId_fkey")
  capacity ProfileSubscriptionCapacity?

  @@index([adhesionId], map: "profile_subscriptions_adhesion_id_idx")
  @@index([productId], map: "profile_subscriptions_product_id_idx")
  @@index([subscriptionStatus], map: "profile_subscriptions_status_idx")
  @@map("corretor_studio_profile_subscriptions")
}

model ProfileSubscriptionCapacity {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileSubscriptionId      String   @unique @db.Uuid
  includedExtraTeams         Int      @default(0)
  includedExtraUsers         Int      @default(0)
  manualAdjustmentExtraTeams Int      @default(0)
  manualAdjustmentExtraUsers Int      @default(0)
  createdAt                  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  profileSubscription ProfileSubscription @relation(fields: [profileSubscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "profile_subscription_capacities_subscription_id_fkey")

  @@map("corretor_studio_profile_subscription_capacities")
}

// -----------------------------
// PROFILE USER TYPE (Comum / Member PRO)
// Lookup table with the user type tiers, plus a 1:1 assignment table
// linking each Profile to its current type (cascades from Profile).
// -----------------------------

model ProfileUserType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique @db.Text
  name        String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  assignments ProfileUserTypeAssignment[]

  @@map("profile_user_types")
}

model ProfileUserTypeAssignment {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId           String    @unique @db.Uuid
  userTypeId          String    @db.Uuid
  accessStartsAt      DateTime? @db.Timestamptz(6)
  accessExpiresAt     DateTime? @db.Timestamptz(6)
  assignedByProfileId String?   @db.Uuid
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  profile    Profile         @relation("ProfileUserTypeAssignment", fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "profile_user_type_assignments_profile_id_fkey")
  userType   ProfileUserType @relation(fields: [userTypeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "profile_user_type_assignments_user_type_id_fkey")
  assignedBy Profile?        @relation("ProfileUserTypeAssignmentAssignedBy", fields: [assignedByProfileId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "profile_user_type_assignments_assigned_by_profile_id_fkey")

  @@index([userTypeId])
  @@index([accessExpiresAt])
  @@map("profile_user_type_assignments")
}

// ============================================
// Dialer module (Studio Voice)
// ============================================

enum DialerCampaignStatus {
  draft
  ready
  running
  paused
  completed
  canceled
  limit_reached

  @@map("dialer_campaign_status")
}

enum DialerCallStatus {
  pending
  calling
  answered
  transferred
  completed
  no_answer
  busy
  failed
  machine

  @@map("dialer_call_status")
}

enum DialerPlan {
  dialer_basic
  dialer_pro
  dialer_unlimited

  @@map("dialer_plan")
}

enum DialerSubscriptionStatus {
  pending
  active
  suspended
  canceled

  @@map("dialer_subscription_status")
}

model DialerCampaign {
  id                String               @id @default(uuid()) @db.Uuid
  teamId            String               @db.Uuid
  managerId         String               @db.Uuid
  name              String               @db.Text
  description       String?              @db.Text
  status            DialerCampaignStatus @default(draft)
  totalContacts     Int                  @default(0)
  contactsProcessed Int                  @default(0)
  contactsAnswered  Int                  @default(0)
  minutesUsed       Decimal              @default(0) @db.Decimal(10, 2)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)

  team     Team            @relation("TeamDialerCampaigns", fields: [teamId], references: [id], onDelete: Cascade)
  manager  Profile         @relation("DialerCampaignManager", fields: [managerId], references: [id], onDelete: Cascade)
  contacts DialerContact[]
  calls    DialerCall[]

  @@index([teamId, status])
  @@index([managerId])
  @@map("corretor_studio_dialer_campaigns")
}

model DialerContact {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  name       String   @db.Text
  phone      String   @db.Text
  email      String?  @db.Text
  metadata   Json?
  processed  Boolean  @default(false)
  position   Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  campaign DialerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  calls    DialerCall[]

  @@unique([campaignId, phone])
  @@index([campaignId, processed])
  @@map("corretor_studio_dialer_contacts")
}

model DialerCall {
  id              String           @id @default(uuid()) @db.Uuid
  campaignId      String           @db.Uuid
  contactId       String           @db.Uuid
  operatorId      String           @db.Uuid
  leadId          String?          @db.Uuid
  twilioCallSid   String?          @unique @db.Text
  status          DialerCallStatus @default(pending)
  durationSeconds Int?
  recordingSid    String?          @db.Text
  recordingUrl    String?          @db.Text // URL temporaria no Twilio
  recordingPath   String?          @db.Text // path permanente no Supabase Storage
  startedAt       DateTime?        @db.Timestamptz(6)
  answeredAt      DateTime?        @db.Timestamptz(6)
  transferredAt   DateTime?        @db.Timestamptz(6)
  endedAt         DateTime?        @db.Timestamptz(6)
  notes           String?          @db.Text
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  campaign DialerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  DialerContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  operator Profile        @relation("DialerCallOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  lead     Lead?          @relation("DialerCallLead", fields: [leadId], references: [id], onDelete: SetNull)

  // Indice unico parcial (1 chamada ativa por operador) criado via SQL manual na migration:
  // corretor_studio_dialer_calls_one_active_call_per_operator
  @@index([campaignId, status])
  @@index([contactId])
  @@index([operatorId])
  @@index([leadId])
  @@map("corretor_studio_dialer_calls")
}

model DialerUsage {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @db.Uuid
  billingMonth String   @db.Text // formato "YYYY-MM"
  minutesUsed  Decimal  @default(0) @db.Decimal(10, 2)
  minutesLimit Decimal  @db.Decimal(10, 2)
  callsCount   Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  team Team @relation("TeamDialerUsage", fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, billingMonth])
  @@map("corretor_studio_dialer_usage")
}

model DialerSubscription {
  id                  String                   @id @default(uuid()) @db.Uuid
  teamId              String                   @unique @db.Uuid
  plan                DialerPlan
  status              DialerSubscriptionStatus @default(pending)
  asaasSubscriptionId String?                  @db.Text
  monthlyMinutes      Int
  currentPeriodStart  DateTime?                @db.Timestamptz(6)
  currentPeriodEnd    DateTime?                @db.Timestamptz(6)
  canceledAt          DateTime?                @db.Timestamptz(6)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(6)

  team Team @relation("TeamDialerSubscription", fields: [teamId], references: [id], onDelete: Cascade)

  @@index([asaasSubscriptionId])
  @@map("corretor_studio_dialer_subscriptions")
}
