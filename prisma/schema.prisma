model BackofficeEmailLog {
  id             String                     @id @default(uuid()) @db.Uuid
  campaignId     String                     @map("campaignId") @db.Uuid
  dispatchId     String                     @map("dispatchId") @db.Uuid
  contactId      String                     @map("contactId") @db.Uuid
