generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./erd/diagram.md"
  format   = "mermaid"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id                             String                              @id @unique @default(uuid()) @db.Uuid
  email                          String                              @unique
  supabaseId                     String?                             @unique @db.Uuid
  fullName                       String?
  phone                          String?
  cpfCnpj                        String?
  postalCode                     String?
  address                        String?
  addressNumber                  String?
  neighborhood                   String?
  complement                     String?
  city                           String?
  state                          String?
  profileIconId                  String?
  profileIconUrl                 String?
  role                           UserRole                            @default(manager)
  functions                      UserFunction[]                      @default([])
  isMaster                       Boolean                             @default(false)
  canCreateAccountUsers          Boolean                             @default(false)
  canManageAccountTeams          Boolean                             @default(false)
  hasPermanentSubscription       Boolean                             @default(false)
  managerId                      String?                             @db.Uuid
  asaasCustomerId                String?
  subscriptionId                 String?
  subscriptionStatus             SubscriptionStatus?
  subscriptionPlan               SubscriptionPlan?
  operatorCount                  Int                                 @default(0)
  subscriptionStartDate          DateTime?                           @db.Timestamptz(6)
  subscriptionEndDate            DateTime?                           @db.Timestamptz(6)
  trialEndDate                   DateTime?                           @db.Timestamptz(6)
  asaasSubscriptionId            String?
  subscriptionNextDueDate        DateTime?                           @db.Timestamptz(6)
  subscriptionCycle              String?
  activeTeamId                   String?                             @db.Uuid
  timezone                       String                              @default("America/Sao_Paulo")
  createdAt                      DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime                            @updatedAt @db.Timestamptz(6)
  googleConnectionId             String?                             @db.Uuid
  createdBackofficeClients       BackofficeClient[]                  @relation("BackofficeClientCreator")
  backofficeFeatureGrants        BackofficeFeatureGrant[]            @relation("BackofficeFeatureProfileGrants")
  createdBackofficeLeads         BackofficeLead[]                    @relation("BackofficeLeadCreator")
  createdBackofficePayments      BackofficePayment[]                 @relation("BackofficePaymentCreator")
  backofficeProductSubscriptions BackofficeUserProductSubscription[] @relation("BackofficeUserProductSubscriptions")
  createdBackofficeUsers         BackofficeUser[]                    @relation("BackofficeUserCreator")
  linkedFromBackofficeUsers      BackofficeUser[]                    @relation("BackofficeUserLinkedProfile")
  backofficeUser                 BackofficeUser?                     @relation("BackofficeUserProfile")
  emailCampaignsCreated          EmailCampaign[]                     @relation("EmailCampaignCreator")
  emailContactListsCreated       EmailContactList[]                  @relation("EmailContactListCreator")
  emailCreditSubscription        EmailCreditSubscription?            @relation("EmailCreditSubscriptionOwner")
  emailTemplatesCreated          EmailTemplate[]                     @relation("EmailTemplateCreator")
  createdHealthPlanOptions       HealthPlanOption[]                  @relation("HealthPlanOptionCreator")
  activities                     LeadActivity[]
  activityReactions              LeadActivityReaction[]
  attachments                    LeadAttachment[]                    @relation("AttachmentUploader")
  finalizedContracts             LeadFinalized[]                     @relation("LeadFinalizedCloser")
  leadsAsAssignee                Lead[]                              @relation("LeadAssignee")
  leadsAsCloser                  Lead[]                              @relation("LeadCloser")
  leadsAsCreator                 Lead[]                              @relation("LeadCreator")
  leadsAsManager                 Lead[]                              @relation("LeadManager")
  leadsAsUpdater                 Lead[]                              @relation("LeadUpdater")
  sentNotifications              Notification[]                      @relation("NotificationActor")
  receivedNotifications          Notification[]                      @relation("NotificationRecipient")
  pendingActions                 PendingAction[]                     @relation("PendingActionMaster")
  pendingOperators               PendingOperator[]                   @relation("PendingOperatorManager")
  subscription                   ProfileSubscription?
  googleConnection               GoogleOAuthConnection?              @relation("ProfileGoogleConnection", fields: [googleConnectionId], references: [id], onUpdate: NoAction)
  manager                        Profile?                            @relation("ManagerOperators", fields: [managerId], references: [id], onDelete: Restrict)
  operators                      Profile[]                           @relation("ManagerOperators")
  taskAssignments                TaskAssignee[]                      @relation("TaskAssigneeProfile")
  createdTasks                   Task[]                              @relation("TaskCreator")
  createdTeamFilterPresets       TeamFilterPreset[]                  @relation("TeamFilterPresetCreator")
  teamMemberships                TeamMember[]
  createdTeamStatusRules         TeamStatusRule[]                    @relation("TeamStatusRuleCreator")
  updatedStudioWebhookConfigs    TeamStudioWebhookConfig[]           @relation("StudioWebhookConfigUpdater")
  teamsOwned                     Team[]                              @relation("TeamMaster")
  ownedGoogleConnections         GoogleOAuthConnection[]             @relation("GoogleConnectionOwnerProfile")
  assignedUserTypeChanges        ProfileUserTypeAssignment[]         @relation("ProfileUserTypeAssignmentAssignedBy")
  userTypeAssignment             ProfileUserTypeAssignment?          @relation("ProfileUserTypeAssignment")

  @@index([role])
  @@index([managerId])
  @@index([cpfCnpj])
  @@index([googleConnectionId], map: "corretor_studio_profiles_google_connection_id_idx")
  @@map("corretor_studio_profiles")
}

model HealthPlanOption {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String    @unique
  createdBy      String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  isActive       Boolean   @default(true)
  isDefault      Boolean   @default(false)
  iconUrl        String?
  activatedAt    DateTime? @db.Timestamptz(6)
  deactivatedAt  DateTime? @db.Timestamptz(6)
  creator        Profile?  @relation("HealthPlanOptionCreator", fields: [createdBy], references: [id])

  @@index([name])
  @@index([createdBy])
  @@map("corretor_studio_health_plan_options")
}

model BackofficeUser {
  id                            String                   @id @default(uuid()) @db.Uuid
  profileId                     String                   @unique @map("profileId") @db.Uuid
  email                         String                   @unique
  fullAccess                    Boolean                  @default(false) @map("fullAccess")
  isActive                      Boolean                  @default(true) @map("isActive")
  isSdr                         Boolean                  @default(true) @map("isSdr")
  isCloser                      Boolean                  @default(true) @map("isCloser")
  timezone                      String                   @default("America/Sao_Paulo")
  mailboxStatus                 String                   @default("pending_manual_action") @map("mailboxStatus")
  mailboxAddress                String?                  @map("mailboxAddress")
  mailboxProvisionedAt          DateTime?                @map("mailboxProvisionedAt") @db.Timestamptz(6)
  createdByProfileId            String?                  @map("createdByProfileId") @db.Uuid
  createdAt                     DateTime                 @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt                     DateTime                 @default(now()) @map("updatedAt") @db.Timestamptz(6)
  googleConnectionId            String?                  @map("googleConnectionId") @db.Uuid
  linkedCorretorStudioProfileId String?                  @map("linkedCorretorStudioProfileId") @db.Uuid
  closerAdhesions               BackofficeAdhesion[]     @relation("BackofficeAdhesionCloser")
  createdAdhesions              BackofficeAdhesion[]     @relation("BackofficeAdhesionCreator")
  sdrAdhesions                  BackofficeAdhesion[]     @relation("BackofficeAdhesionSdr")
  closerLeads                   BackofficeLead[]         @relation("BackofficeLeadCloser")
  sdrLeads                      BackofficeLead[]         @relation("BackofficeLeadSdr")
  schedulesAsCloser             BackofficeLeadSchedule[] @relation("BackofficeLeadScheduleCloser")
  creator                       Profile?                 @relation("BackofficeUserCreator", fields: [createdByProfileId], references: [id])
  googleConnection              GoogleOAuthConnection?   @relation("BackofficeUserGoogleConnection", fields: [googleConnectionId], references: [id], onUpdate: NoAction)
  linkedCorretorStudioProfile   Profile?                 @relation("BackofficeUserLinkedProfile", fields: [linkedCorretorStudioProfileId], references: [id], onUpdate: NoAction)
  profile                       Profile                  @relation("BackofficeUserProfile", fields: [profileId], references: [id], onDelete: Cascade)
  generatedWebhookTokens        BackofficeWebhookToken[] @relation("BackofficeWebhookTokenGenerator")

  @@index([isActive], map: "backoffice_users_is_active_idx")
  @@index([isSdr], map: "backoffice_users_is_sdr_idx")
  @@index([isCloser], map: "backoffice_users_is_closer_idx")
  @@index([googleConnectionId], map: "backoffice_users_google_connection_id_idx")
  @@index([linkedCorretorStudioProfileId], map: "backoffice_users_linked_profile_id_idx")
  @@index([createdByProfileId], map: "backoffice_users_created_by_profile_id_idx")
  @@map("backoffice_users")
}

model GoogleOAuthConnection {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleEmail      String           @unique
  accessToken      String?
  refreshToken     String?
  tokenExpiresAt   DateTime?        @db.Timestamptz(6)
  scopes           String[]         @default([])
  ownerProfileId   String?          @db.Uuid
  lastRefreshedAt  DateTime?        @db.Timestamptz(6)
  lastRefreshError String?
  revokedAt        DateTime?        @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  backofficeUsers  BackofficeUser[] @relation("BackofficeUserGoogleConnection")
  profiles         Profile[]        @relation("ProfileGoogleConnection")
  ownerProfile     Profile?         @relation("GoogleConnectionOwnerProfile", fields: [ownerProfileId], references: [id], onUpdate: NoAction)

  @@index([googleEmail], map: "google_oauth_connections_google_email_idx")
  @@index([ownerProfileId], map: "google_oauth_connections_owner_profile_id_idx")
  @@map("google_oauth_connections")
}

model BackofficeClient {
  id                 String              @id @default(uuid()) @db.Uuid
  fullName           String              @map("fullName")
  email              String?
  phone              String?
  cpfCnpj            String?             @map("cpfCnpj")
  notes              String?
  asaasCustomerId    String?             @unique @map("asaasCustomerId")
  isActive           Boolean             @default(true) @map("isActive")
  createdByProfileId String?             @map("createdByProfileId") @db.Uuid
  createdAt          DateTime            @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @map("updatedAt") @db.Timestamptz(6)
  creator            Profile?            @relation("BackofficeClientCreator", fields: [createdByProfileId], references: [id])
  payments           BackofficePayment[]

  @@index([email])
  @@index([cpfCnpj], map: "backoffice_clients_cpf_cnpj_idx")
  @@index([isActive], map: "backoffice_clients_is_active_idx")
  @@map("backoffice_clients")
}

model BackofficePayment {
  id                 String           @id @default(uuid()) @db.Uuid
  clientId           String           @map("clientId") @db.Uuid
  asaasPaymentId     String?          @unique @map("asaasPaymentId")
  billingType        String           @default("PIX") @map("billingType")
  status             String           @default("PENDING")
  amount             Decimal          @db.Decimal(12, 2)
  dueDate            DateTime?        @map("dueDate") @db.Timestamptz(6)
  description        String?
  invoiceUrl         String?          @map("invoiceUrl")
  pixQrCode          String?          @map("pixQrCode")
  pixPayload         String?          @map("pixPayload")
  createdByProfileId String?          @map("createdByProfileId") @db.Uuid
  createdAt          DateTime         @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @map("updatedAt") @db.Timestamptz(6)
  client             BackofficeClient @relation(fields: [clientId], references: [id])
  creator            Profile?         @relation("BackofficePaymentCreator", fields: [createdByProfileId], references: [id])

  @@index([clientId], map: "backoffice_payments_client_id_idx")
  @@index([status])
  @@index([dueDate], map: "backoffice_payments_due_date_idx")
  @@map("backoffice_payments")
}

model BackofficeLead {
  id                            String                   @id @default(uuid()) @db.Uuid
  name                          String
  email                         String?
  phone                         String?
  cpfCnpj                       String?
  notes                         String?
  status                        BackofficeLeadStatus     @default(new_opportunity)
  origin                        BackofficeLeadOrigin     @default(manual)
  sourceExternalId              String?                  @unique(map: "backoffice_leads_source_external_id_key") @map("sourceExternalId")
  sourceWebhookEventId          String?                  @unique(map: "backoffice_leads_source_webhook_event_id_key") @map("sourceWebhookEventId") @db.Uuid
  sdrBackofficeUserId           String?                  @map("sdrBackofficeUserId") @db.Uuid
  closerBackofficeUserId        String?                  @map("closerBackofficeUserId") @db.Uuid
  meetingDate                   DateTime?                @map("meetingDate") @db.Timestamptz(6)
  meetingTitle                  String?                  @map("meetingTitle")
  meetingNotes                  String?                  @map("meetingNotes")
  meetingLink                   String?                  @map("meetingLink")
  meetingExtraGuests            String[]                 @default([]) @map("meetingExtraGuests")
  statusEnteredAt               DateTime                 @default(now()) @map("statusEnteredAt") @db.Timestamptz(6)
  createdByProfileId            String?                  @map("createdByProfileId") @db.Uuid
  createdAt                     DateTime                 @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt                     DateTime                 @updatedAt @map("updatedAt") @db.Timestamptz(6)
  qualificationLeadOrganization String?                  @map("qualification_lead_organization")
  qualificationAvgUsers         String?                  @map("qualification_avg_users")
  qualificationProfileFit       String?                  @map("qualification_profile_fit")
  adhesion                      BackofficeAdhesion?
  closerBackofficeUser          BackofficeUser?          @relation("BackofficeLeadCloser", fields: [closerBackofficeUserId], references: [id], map: "backoffice_leads_closer_backoffice_user_id_fkey")
  creator                       Profile?                 @relation("BackofficeLeadCreator", fields: [createdByProfileId], references: [id])
  sdrBackofficeUser             BackofficeUser?          @relation("BackofficeLeadSdr", fields: [sdrBackofficeUserId], references: [id], map: "backoffice_leads_sdr_backoffice_user_id_fkey")
  sourceWebhookEvent            BackofficeWebhookEvent?  @relation("BackofficeLeadSourceWebhookEvent", fields: [sourceWebhookEventId], references: [id], map: "backoffice_leads_source_webhook_event_id_fkey")
  schedules                     BackofficeLeadSchedule[]

  @@index([status])
  @@index([origin])
  @@index([sdrBackofficeUserId], map: "backoffice_leads_sdr_user_id_idx")
  @@index([closerBackofficeUserId], map: "backoffice_leads_closer_user_id_idx")
  @@index([meetingDate], map: "backoffice_leads_meeting_date_idx")
  @@index([createdByProfileId], map: "backoffice_leads_created_by_profile_id_idx")
  @@index([email])
  @@index([cpfCnpj], map: "backoffice_leads_cpf_cnpj_idx")
  @@map("backoffice_leads")
}

model BackofficeAdhesion {
  id                                String                         @id @default(uuid()) @db.Uuid
  leadId                            String                         @unique @map("leadId") @db.Uuid
  fullName                          String                         @map("fullName")
  phone                             String
  email                             String?
  cpfCnpj                           String?                        @map("cpfCnpj")
  postalCode                        String?                        @map("postalCode")
  address                           String?
  addressNumber                     String?                        @map("addressNumber")
  neighborhood                      String?
  complement                        String?
  city                              String?
  state                             String?
  plan                              BackofficeAdhesionPlan         @default(crm)
  cycle                             BackofficeAdhesionBillingCycle
  modules                           String[]                       @default(["crm"])
  extraTeams                        Int                            @default(0) @map("extraTeams")
  extraUsers                        Int                            @default(0) @map("extraUsers")
  monthlyBaseAmount                 Decimal                        @map("monthlyBaseAmount") @db.Decimal(12, 2)
  monthlyExtraTeamsAmount           Decimal                        @map("monthlyExtraTeamsAmount") @db.Decimal(12, 2)
  monthlyExtraUsersAmount           Decimal                        @map("monthlyExtraUsersAmount") @db.Decimal(12, 2)
  monthlyTotalAmount                Decimal                        @map("monthlyTotalAmount") @db.Decimal(12, 2)
  totalAmount                       Decimal                        @map("totalAmount") @db.Decimal(12, 2)
  tokenHash                         String                         @unique @map("tokenHash")
  tokenPreview                      String                         @map("tokenPreview")
  expiresAt                         DateTime                       @map("expiresAt") @db.Timestamptz(6)
  status                            BackofficeAdhesionStatus       @default(pending)
  tokenPlain                        String?                        @map("tokenPlain")
  sdrBackofficeUserId               String?                        @map("sdrBackofficeUserId") @db.Uuid
  closerBackofficeUserId            String?                        @map("closerBackofficeUserId") @db.Uuid
  createdByBackofficeUserId         String?                        @map("createdByBackofficeUserId") @db.Uuid
  asaasCustomerId                   String?                        @map("asaasCustomerId")
  asaasPaymentId                    String?                        @unique @map("asaasPaymentId")
  asaasInstallmentId                String?                        @unique(map: "backoffice_adhesions_asaasinstallmentid_key") @map("asaasInstallmentId")
  installmentCount                  Int?                           @map("installmentCount")
  billingType                       String?                        @map("billingType")
  paymentDueDate                    DateTime?                      @map("paymentDueDate") @db.Timestamptz(6)
  invoiceUrl                        String?                        @map("invoiceUrl")
  bankSlipUrl                       String?                        @map("bankSlipUrl")
  pixQrCode                         String?                        @map("pixQrCode")
  pixPayload                        String?                        @map("pixPayload")
  paidAt                            DateTime?                      @map("paidAt") @db.Timestamptz(6)
  overdueAt                         DateTime?                      @map("overdueAt") @db.Timestamptz(6)
  canceledAt                        DateTime?                      @map("canceledAt") @db.Timestamptz(6)
  createdProfileId                  String?                        @map("createdProfileId") @db.Uuid
  createdSupabaseId                 String?                        @map("createdSupabaseId") @db.Uuid
  createdAt                         DateTime                       @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt                         DateTime                       @updatedAt @map("updatedAt") @db.Timestamptz(6)
  requestedUserTypeSlug             String?                        @map("requestedUserTypeSlug")
  requestedMemberProAccessExpiresAt DateTime?                      @map("requestedMemberProAccessExpiresAt") @db.Timestamptz(6)
  closerBackofficeUser              BackofficeUser?                @relation("BackofficeAdhesionCloser", fields: [closerBackofficeUserId], references: [id])
  createdByBackofficeUser           BackofficeUser?                @relation("BackofficeAdhesionCreator", fields: [createdByBackofficeUserId], references: [id])
  lead                              BackofficeLead                 @relation(fields: [leadId], references: [id])
  sdrBackofficeUser                 BackofficeUser?                @relation("BackofficeAdhesionSdr", fields: [sdrBackofficeUserId], references: [id])
  profileSubscription               ProfileSubscription?

  @@index([status])
  @@index([expiresAt], map: "backoffice_adhesions_expires_at_idx")
  @@index([leadId], map: "backoffice_adhesions_lead_id_idx")
  @@index([sdrBackofficeUserId], map: "backoffice_adhesions_sdr_user_id_idx")
  @@index([closerBackofficeUserId], map: "backoffice_adhesions_closer_user_id_idx")
  @@map("backoffice_adhesions")
}

model BackofficeLeadSchedule {
  id                          String                          @id @default(uuid()) @db.Uuid
  leadId                      String                          @map("leadId") @db.Uuid
  closerBackofficeUserId      String?                         @map("closerBackofficeUserId") @db.Uuid
  date                        DateTime                        @db.Timestamptz(6)
  meetingTitle                String?                         @map("meetingTitle")
  notes                       String?
  meetingLink                 String?                         @map("meetingLink")
  extraGuests                 String[]                        @default([]) @map("extraGuests")
  googleEventId               String?                         @map("googleEventId")
  googleCalendarId            String?                         @map("googleCalendarId")
  inviteDispatchStatus        BackofficeInviteDispatchStatus? @map("inviteDispatchStatus")
  inviteDispatchProvider      String?                         @map("inviteDispatchProvider")
  inviteDispatchFallbackUsed  Boolean                         @default(false) @map("inviteDispatchFallbackUsed")
  inviteDispatchLastAttemptAt DateTime?                       @map("inviteDispatchLastAttemptAt") @db.Timestamptz(6)
  inviteDispatchLastError     String?                         @map("inviteDispatchLastError")
  inviteDispatchLastPayload   Json?                           @map("inviteDispatchLastPayload")
  isCanceled                  Boolean                         @default(false) @map("isCanceled")
  canceledAt                  DateTime?                       @map("canceledAt") @db.Timestamptz(6)
  canceledByProfileId         String?                         @map("canceledByProfileId") @db.Uuid
  cancelReason                String?                         @map("cancelReason")
  createdByProfileId          String?                         @map("createdByProfileId") @db.Uuid
  createdAt                   DateTime                        @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt                   DateTime                        @updatedAt @map("updatedAt") @db.Timestamptz(6)
  closer                      BackofficeUser?                 @relation("BackofficeLeadScheduleCloser", fields: [closerBackofficeUserId], references: [id], map: "backoffice_leads_schedule_closer_backoffice_user_id_fkey")
  lead                        BackofficeLead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId], map: "backoffice_leads_schedule_lead_id_idx")
  @@index([closerBackofficeUserId], map: "backoffice_leads_schedule_closer_user_id_idx")
  @@index([date])
  @@index([isCanceled], map: "backoffice_leads_schedule_is_canceled_idx")
  @@map("backoffice_leads_schedule")
}

model BackofficeWebhookEvent {
  id           String                       @id @default(uuid()) @db.Uuid
  source       BackofficeWebhookSource
  eventType    String?                      @map("eventType")
  payload      Json
  signature    String?
  status       BackofficeWebhookEventStatus @default(received)
  errorMessage String?                      @map("errorMessage")
  receivedAt   DateTime                     @default(now()) @map("receivedAt") @db.Timestamptz(6)
  processedAt  DateTime?                    @map("processedAt") @db.Timestamptz(6)
  createdLead  BackofficeLead?              @relation("BackofficeLeadSourceWebhookEvent")

  @@index([source, receivedAt(sort: Desc)], map: "backoffice_webhook_events_source_received_at_idx")
  @@index([status])
  @@map("backoffice_webhook_events")
}

model BackofficeWebhookToken {
  id                          String                           @id @default(uuid()) @db.Uuid
  source                      BackofficeWebhookSource
  tokenHash                   String                           @map("tokenHash")
  tokenCipher                 String                           @map("tokenCipher")
  tokenPreview                String                           @map("tokenPreview")
  status                      BackofficeWebhookTokenStatus     @default(active)
  expiryMode                  BackofficeWebhookTokenExpiryMode @default(indeterminate) @map("expiryMode")
  expiresAt                   DateTime?                        @map("expiresAt") @db.Timestamptz(6)
  lastUsedAt                  DateTime?                        @map("lastUsedAt") @db.Timestamptz(6)
  generatedByBackofficeUserId String                           @map("generatedByBackofficeUserId") @db.Uuid
  generatedByEmailSnapshot    String                           @map("generatedByEmailSnapshot")
  generatedAt                 DateTime                         @default(now()) @map("generatedAt") @db.Timestamptz(6)
  updatedAt                   DateTime                         @updatedAt @map("updatedAt") @db.Timestamptz(6)
  generatedBy                 BackofficeUser                   @relation("BackofficeWebhookTokenGenerator", fields: [generatedByBackofficeUserId], references: [id])

  @@index([source, status])
  @@index([generatedAt(sort: Desc)], map: "backoffice_webhook_tokens_generated_at_idx")
  @@index([expiresAt], map: "backoffice_webhook_tokens_expires_at_idx")
  @@index([generatedByBackofficeUserId], map: "backoffice_webhook_tokens_generated_by_idx")
  @@map("backoffice_webhook_tokens")
}

model BackofficeWebhookRequestLog {
  id              String                  @id @default(uuid()) @db.Uuid
  source          BackofficeWebhookSource
  method          String
  endpoint        String
  statusCode      Int                     @map("statusCode")
  resultType      String                  @map("resultType")
  requestPayload  Json?                   @map("requestPayload")
  responsePayload Json?                   @map("responsePayload")
  errorMessage    String?                 @map("errorMessage")
  createdAt       DateTime                @default(now()) @map("createdAt") @db.Timestamptz(6)

  @@index([source, createdAt(sort: Desc)], map: "backoffice_webhook_request_logs_source_created_at_idx")
  @@index([statusCode], map: "backoffice_webhook_request_logs_status_code_idx")
  @@map("backoffice_webhook_request_logs")
}

model Lead {
  id                   String           @id @unique @default(uuid()) @db.Uuid
  leadCode             String           @unique
  managerId            String           @db.Uuid
  teamId               String?          @db.Uuid
  assignedTo           String?          @db.Uuid
  closerId             String?          @db.Uuid
  status               LeadStatus       @default(new_opportunity)
  name                 String
  email                String?
  phone                String?
  cnpj                 String?
  age                  String?
  currentHealthPlan    String?
  currentValue         Decimal?         @db.Decimal(12, 2)
  referenceHospital    String?
  currentTreatment     String?
  meetingDate          DateTime?        @db.Timestamptz(6)
  meetingTitle         String?
  meetingNotes         String?
  meetingLink          String?
  meetingHeald         MeetingHeald?
  followUpAt           DateTime?        @db.Timestamptz(6)
  followUpNotes        String?
  followUpSourceStatus LeadStatus?
  lossReason           String?
  lossReasonDetails    String?
  statusEnteredAt      DateTime         @default(now()) @db.Timestamptz(6)
  notes                String?
  ticket               Decimal?         @db.Decimal(12, 2)
  contractDueDate      DateTime?        @db.Timestamptz(6)
  soldPlan             String?
  createdBy            String?          @db.Uuid
  updatedBy            String?          @db.Uuid
  createdAt            DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(6)
  meetingType          String?
  isReferral           Boolean?         @default(false)
  referrerLeadId       String?          @db.Uuid
  referrerName         String?
