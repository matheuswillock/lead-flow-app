// -----------------------------
// PROFILES (public.profiles)
// - Primary key is also a FK to auth.users.id (1:1)
// - Self-relation: operator -> manager
// -----------------------------

model Profile {
  id                       String              @id @unique @default(uuid()) @db.Uuid
  email                    String              @unique @db.Text
  supabaseId               String?             @unique @db.Uuid
  fullName                 String?             @db.Text
  phone                    String?             @db.Text
  cpfCnpj                  String?             @db.Text
  postalCode               String?             @db.Text
  address                  String?             @db.Text
  addressNumber            String?             @db.Text
  neighborhood             String?             @db.Text
  complement               String?             @db.Text
  city                     String?             @db.Text
  state                    String?             @db.Text
  profileIconId            String?             @db.Text
  profileIconUrl           String?             @db.Text
  role                     UserRole            @default(manager)
  functions                UserFunction[]      @default([])
  isMaster                 Boolean             @default(false) // Indica se é o dono da assinatura
  hasPermanentSubscription Boolean             @default(false) // Indica se tem assinatura permanente (não precisa pagar)
  hasUnlimitedUsers        Boolean             @default(false) // Master com usuários ilimitados (sem cobrança/checkout de usuário)
  multiskillEnabled        Boolean             @default(false) // Master habilitado a receber transferências MultiSkill
  googleConnectionId       String?             @db.Uuid
  managerId                String?             @db.Uuid
  sponsorMasterId          String?             @db.Uuid
  asaasCustomerId          String?             @db.Text
  subscriptionId           String?             @db.Text
  subscriptionStatus       SubscriptionStatus?
  subscriptionPlan         SubscriptionPlan?
  operatorCount            Int                 @default(0)
  subscriptionStartDate    DateTime?           @db.Timestamptz(6)
  subscriptionEndDate      DateTime?           @db.Timestamptz(6)
  trialEndDate             DateTime?           @db.Timestamptz(6)
  asaasSubscriptionId      String?             @db.Text // ID da assinatura no Asaas
  subscriptionNextDueDate  DateTime?           @db.Timestamptz(6) // Próxima data de vencimento
  subscriptionCycle        String?             @db.Text // MONTHLY, QUARTERLY, etc
  activeTeamId             String?             @db.Uuid
  timezone                 String              @default("America/Sao_Paulo") @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  manager   Profile?  @relation("ManagerOperators", fields: [managerId], references: [id], onDelete: Restrict)
  operators Profile[] @relation("ManagerOperators")

  sponsorMaster     Profile?  @relation("ProfileSponsor", fields: [sponsorMasterId], references: [id], onDelete: Restrict)
  sponsoredAccounts Profile[] @relation("ProfileSponsor")

  // Lead relations
  leadsAsManager    Lead[]                 @relation("LeadManager")
  leadsAsAssignee   Lead[]                 @relation("LeadAssignee")
  leadsAsCloser     Lead[]                 @relation("LeadCloser")
  leadsAsCreator    Lead[]                 @relation("LeadCreator")
  leadsAsUpdater    Lead[]                 @relation("LeadUpdater")
  activities        LeadActivity[]
  activityReactions LeadActivityReaction[]
  attachments       LeadAttachment[]       @relation("AttachmentUploader")

  // Pending Operators relations
  pendingOperators            PendingOperator[]         @relation("PendingOperatorManager")
  pendingActions              PendingAction[]           @relation("PendingActionMaster")
  teamsOwned                  Team[]                    @relation("TeamMaster")
  teamMemberships             TeamMember[]
  createdTeamTransferRoutes   TeamTransferRoute[]       @relation("TeamTransferRouteCreator")
  outboundLeadTransfers       LeadTransfer[]           @relation("LeadTransferActor")
  inboundLeadTransfers        LeadTransfer[]           @relation("LeadTransferRecipient")
  createdHealthPlanOptions    HealthPlanOption[]        @relation("HealthPlanOptionCreator")
  backofficeUser              BackofficeUser?           @relation("BackofficeUserProfile")
  googleConnection            GoogleOAuthConnection?    @relation("ProfileGoogleConnection", fields: [googleConnectionId], references: [id], onDelete: SetNull)
  ownedGoogleConnections      GoogleOAuthConnection[]   @relation("GoogleConnectionOwnerProfile")
  linkedFromBackofficeUsers   BackofficeUser[]          @relation("BackofficeUserLinkedProfile")
  createdBackofficeUsers      BackofficeUser[]          @relation("BackofficeUserCreator")
  createdBackofficeClients    BackofficeClient[]        @relation("BackofficeClientCreator")
  createdBackofficePayments   BackofficePayment[]       @relation("BackofficePaymentCreator")
  createdBackofficeLeads      BackofficeLead[]          @relation("BackofficeLeadCreator")
  createdBackofficeContracts  BackofficeContract[]      @relation("BackofficeContractCreator")
  importedBackofficeContractVersions BackofficeContractVersion[] @relation("BackofficeContractVersionImporter")
  sharedBackofficeContractVersions   BackofficeContractVersion[] @relation("BackofficeContractVersionShareGenerator")
  receivedNotifications       Notification[]            @relation("NotificationRecipient")
  sentNotifications           Notification[]            @relation("NotificationActor")
  meetingFollowUpDigestLogs   MeetingFollowUpDigestLog[] @relation("MeetingFollowUpDigestRecipient")
  webPushSubscriptions        ProfileWebPushSubscription[] @relation("ProfileWebPushSubscriptions")
  webPushConsent              ProfileWebPushConsent?       @relation("ProfileWebPushConsents")
  updatedStudioWebhookConfigs TeamStudioWebhookConfig[] @relation("StudioWebhookConfigUpdater")
  createdTeamFilterPresets    TeamFilterPreset[]        @relation("TeamFilterPresetCreator")
  createdTeamStatusRules      TeamStatusRule[]          @relation("TeamStatusRuleCreator")
  createdTeamAutomationRules  TeamAutomationRule[]      @relation("TeamAutomationRuleCreator")
  createdLeadCustomFieldDefinitions LeadCustomFieldDefinition[] @relation("LeadCustomFieldDefinitionCreator")
  updatedLeadStatusTransitionFieldRules BackofficeLeadStatusTransitionFieldRule[] @relation("BackofficeLeadStatusTransitionFieldRuleUpdater")
  updatedLeadStatusTransitionGates BackofficeLeadStatusTransitionGate[] @relation("BackofficeLeadStatusTransitionGateUpdater")
  finalizedContracts          LeadFinalized[]           @relation("LeadFinalizedCloser")
  createdTasks                Task[]                    @relation("TaskCreator")
  taskAssignments             TaskAssignee[]            @relation("TaskAssigneeProfile")
  backofficeEmailDispatches   BackofficeEmailDispatch[] @relation("ProfileBackofficeEmailDispatches")

  // Email campaigns relations
  emailTemplatesCreated    EmailTemplate[]          @relation("EmailTemplateCreator")
  emailTemplatesApproved   EmailTemplate[]          @relation("EmailTemplateApprover")
  emailTemplatesRejected   EmailTemplate[]          @relation("EmailTemplateRejecter")
  emailTemplateHistory     EmailTemplateHistory[]   @relation("EmailTemplateHistoryActor")
  emailContactListsCreated EmailContactList[]       @relation("EmailContactListCreator")
  emailImportJobsRequested EmailImportJob[]         @relation("EmailImportJobRequester")
  emailCampaignsCreated    EmailCampaign[]          @relation("EmailCampaignCreator")
  emailCampaignDispatchesTriggered EmailCampaignDispatch[] @relation("EmailCampaignDispatchTriggerer")

  // Backoffice subscriptions
  backofficeSubscriptions BackofficeUserSubscription[] @relation("BackofficeUserSubscriptions")
  backofficeFeatureGrants BackofficeFeatureGrant[]     @relation("BackofficeFeatureProfileGrants")

  backofficeBotUserLinks               BackofficeBotUserLink[]
  backofficeBotAuthChallenges          BackofficeBotAuthChallenge[]
  backofficeBotNotificationPreferences BackofficeBotNotificationPreference[]
  backofficeBotEventOutbox             BackofficeBotEventOutbox[]
  backofficeBansReceived               BackofficeBannedUser[] @relation("BackofficeBannedUserTarget")
  backofficeBansIssued                 BackofficeBannedUser[] @relation("BackofficeBannedUserIssuer")
  backofficeBansLifted                 BackofficeBannedUser[] @relation("BackofficeBannedUserLifter")

  // Product subscription (master only; operators inherit via managerId)
  subscription ProfileSubscription?

  // User type (Comum / Member PRO)
  userTypeAssignment      ProfileUserTypeAssignment?  @relation("ProfileUserTypeAssignment")
  assignedUserTypeChanges ProfileUserTypeAssignment[] @relation("ProfileUserTypeAssignmentAssignedBy")

  // WhatsApp relations
  whatsappConfigsCreated  TeamWhatsAppConfig[]   @relation("WhatsAppConfigCreatedBy")
  whatsappConfigsUpdated  TeamWhatsAppConfig[]   @relation("WhatsAppConfigUpdatedBy")
  whatsappConversations         WhatsAppConversation[] @relation("WhatsAppConversationAssignee")
  whatsappConversationsCreated  WhatsAppConversation[] @relation("WhatsAppConversationCreator")
  whatsappMessagesSent          WhatsAppMessage[]      @relation("WhatsAppMessageSentBy")

  proposalReviewsReviewed LeadProposalReview[]  @relation("LeadProposalReviewReviewer")
  requiredDocumentsReviewed LeadRequiredDocument[] @relation("LeadRequiredDocumentReviewer")

  authorizedSponsorRecord       BackofficeAuthorizedSponsor?  @relation("AuthorizedSponsorProfile")
  authorizedSponsorsGranted     BackofficeAuthorizedSponsor[] @relation("AuthorizedSponsorGrantedBy")
  authorizedSponsorsRevoked     BackofficeAuthorizedSponsor[] @relation("AuthorizedSponsorRevokedBy")
  operationalAccessGrants       BackofficeOperationalAccessGrant[] @relation("OperationalAccessProfile")
  operationalAccessGrantsGranted BackofficeOperationalAccessGrant[] @relation("OperationalAccessGrantedBy")
  operationalAccessGrantsRevoked BackofficeOperationalAccessGrant[] @relation("OperationalAccessRevokedBy")
  sponsoredAdhesions            BackofficeAdhesion[]          @relation("BackofficeAdhesionSponsorMaster")

  auditLogsAsActor              AuditLog[]                    @relation("AuditLogActor")

  @@index([role])
  @@index([managerId])
  @@index([sponsorMasterId])
  @@index([cpfCnpj])
  @@index([googleConnectionId])
  @@map("corretor_studio_profiles")
}

model HealthPlanOption {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.Text
  normalizedName String   @unique @db.Text
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  iconUrl        String?  @db.Text
  createdBy      String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  activatedAt    DateTime? @db.Timestamptz(6)
  deactivatedAt  DateTime? @db.Timestamptz(6)

  creator Profile? @relation("HealthPlanOptionCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([isActive, isDefault])
  @@index([createdBy])
  @@map("corretor_studio_health_plan_options")
}

// -----------------------------
// BACKOFFICE MODULE (public.backoffice_*)
// -----------------------------

model BackofficeUser {
  id                      String    @id @default(uuid()) @db.Uuid
  profileId               String    @unique @map("profileId") @db.Uuid
  email                   String    @unique @db.Text
  fullAccess              Boolean   @default(false) @map("fullAccess")
  isActive                Boolean   @default(true) @map("isActive")
  isSdr                   Boolean   @default(true) @map("isSdr")
  isCloser                Boolean   @default(true) @map("isCloser")
  googleConnectionId      String?   @map("googleConnectionId") @db.Uuid
  linkedCorretorStudioProfileId String? @map("linkedCorretorStudioProfileId") @db.Uuid
  timezone                String    @default("America/Sao_Paulo") @db.Text
  mailboxStatus           String    @default("pending_manual_action") @map("mailboxStatus") @db.Text
  mailboxAddress          String?   @map("mailboxAddress") @db.Text
  mailboxProvisionedAt    DateTime? @map("mailboxProvisionedAt") @db.Timestamptz(6)
  createdByProfileId      String?   @map("createdByProfileId") @db.Uuid
  createdAt               DateTime  @default(now()) @map("createdAt") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @map("updatedAt") @db.Timestamptz(6)

  profile                Profile                  @relation("BackofficeUserProfile", fields: [profileId], references: [id], onDelete: Cascade)
  creator                Profile?                 @relation("BackofficeUserCreator", fields: [createdByProfileId], references: [id], onDelete: SetNull)
  googleConnection       GoogleOAuthConnection?   @relation("BackofficeUserGoogleConnection", fields: [googleConnectionId], references: [id], onDelete: SetNull)
  linkedCorretorStudioProfile Profile?            @relation("BackofficeUserLinkedProfile", fields: [linkedCorretorStudioProfileId], references: [id], onDelete: SetNull)
  generatedWebhookTokens BackofficeWebhookToken[] @relation("BackofficeWebhookTokenGenerator")
  sdrLeads               BackofficeLead[]         @relation("BackofficeLeadSdr")
  closerLeads            BackofficeLead[]         @relation("BackofficeLeadCloser")
  schedulesAsCloser      BackofficeLeadSchedule[] @relation("BackofficeLeadScheduleCloser")
  sdrAdhesions           BackofficeAdhesion[]     @relation("BackofficeAdhesionSdr")
  closerAdhesions        BackofficeAdhesion[]     @relation("BackofficeAdhesionCloser")
  createdAdhesions       BackofficeAdhesion[]     @relation("BackofficeAdhesionCreator")
  emailCampaignsCreated  BackofficeEmailCampaign[]     @relation("BackofficeEmailCampaignCreator")
  emailContactListsCreated BackofficeEmailContactList[] @relation("BackofficeEmailContactListCreator")
  emailImportJobsCreated BackofficeEmailImportJob[]    @relation("BackofficeEmailImportJobCreator")

  @@index([isActive], map: "backoffice_users_is_active_idx")
  @@index([isSdr], map: "backoffice_users_is_sdr_idx")
  @@index([isCloser], map: "backoffice_users_is_closer_idx")
  @@index([googleConnectionId], map: "backoffice_users_google_connection_id_idx")
  @@index([linkedCorretorStudioProfileId], map: "backoffice_users_linked_profile_id_idx")
  @@index([createdByProfileId], map: "backoffice_users_created_by_profile_id_idx")
  @@map("backoffice_users")
}

model BackofficeBannedUser {
  id                  String              @id @default(uuid()) @db.Uuid
  profileId           String              @map("profileId") @db.Uuid
  supabaseId          String?             @map("supabaseId") @db.Uuid
  email               String              @db.Text
  fullName            String?             @db.Text
  reason              String?             @db.Text
  status              BackofficeBanStatus @default(ACTIVE)
  scope               BackofficeBanScope  @default(INDIVIDUAL)
  bannedByProfileId   String              @map("bannedByProfileId") @db.Uuid
  bannedAt            DateTime            @default(now()) @map("bannedAt") @db.Timestamptz(6)
  liftedByProfileId   String?             @map("liftedByProfileId") @db.Uuid
  liftedAt            DateTime?           @map("liftedAt") @db.Timestamptz(6)
