  fromEmail                 String?                        @map("fromEmail") @db.Text
  replyTo                   String?                        @map("replyTo") @db.Text
  scheduledAt               DateTime                       @map("scheduledAt") @db.Timestamptz(6)
  sentAt                    DateTime?                      @map("sentAt") @db.Timestamptz(6)
