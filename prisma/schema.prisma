  createdAt             DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                      @updatedAt @db.Timestamptz(6)
  accessRules           BackofficeFeatureAccessRule[]
  grants                BackofficeFeatureGrant[]
  parent                BackofficeFeature?            @relation("BackofficeFeatureTree", fields: [parentId], references: [id])
  children              BackofficeFeature[]           @relation("BackofficeFeatureTree")
  product               BackofficeProduct?            @relation(fields: [productSlug], references: [slug])

  @@index([parentId], map: "backoffice_features_parent_id_idx")
  @@index([productSlug], map: "backoffice_features_product_slug_idx")
  @@index([isActive, sortOrder], map: "backoffice_features_active_sort_idx")
  @@map("backoffice_features")
}

model BackofficeFeatureAccessRule {
  id          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  featureId   String                       @db.Uuid
  principal   BackofficeAccessPrincipal
  accessLevel BackofficeFeatureAccessLevel
  createdAt   DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                     @updatedAt @db.Timestamptz(6)
  feature     BackofficeFeature            @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, principal], map: "backoffice_feature_access_rules_feature_principal_key")
  @@index([featureId], map: "backoffice_feature_access_rules_feature_id_idx")
  @@map("backoffice_feature_access_rules")
}

model BackofficeFeatureGrant {
  id          String                       @id @default(uuid()) @db.Uuid
  featureId   String                       @db.Uuid
  profileId   String                       @db.Uuid
  grantType   BackofficeFeatureGrantType   @default(BETA)
  accessLevel BackofficeFeatureAccessLevel @default(FULL)
  isActive    Boolean                      @default(true)
  createdAt   DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                     @updatedAt @db.Timestamptz(6)
  feature     BackofficeFeature            @relation(fields: [featureId], references: [id], onDelete: Cascade)
  profile     Profile                      @relation("BackofficeFeatureProfileGrants", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([featureId, profileId, grantType], map: "backoffice_feature_grants_feature_profile_grant_type_key")
  @@index([profileId, grantType, isActive], map: "backoffice_feature_grants_profile_grant_type_active_idx")
  @@index([featureId, isActive], map: "backoffice_feature_grants_feature_active_idx")
  @@map("backoffice_feature_grants")
}

model BackofficeProductPaymentRule {
  id              String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String                         @db.Uuid
  paymentMethod   BackofficePaymentMethod
  billingCycle    BackofficeAdhesionBillingCycle
  price           Decimal                        @db.Decimal(10, 2)
  canInstallment  Boolean                        @default(false)
  maxInstallments Int                            @default(1)
  createdAt       DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)
  product         BackofficeProduct              @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "backoffice_product_payment_rules_productid_fkey")

  @@unique([productId, paymentMethod, billingCycle], map: "backoffice_product_payment_rules_unique")
  @@index([productId], map: "backoffice_product_payment_rules_productid_idx")
  @@map("backoffice_product_payment_rules")
}

model BackofficeUserProductSubscription {
  id         String                          @id @default(uuid()) @db.Uuid
  profileId  String                          @db.Uuid
  productId  String                          @db.Uuid
  status     BackofficeSubscriptionStatus    @default(active)
  cycle      BackofficeAdhesionBillingCycle?
  startDate  DateTime                        @db.Timestamptz(6)
  endDate    DateTime?                       @db.Timestamptz(6)
  adhesionId String?                         @db.Uuid
  createdAt  DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime                        @updatedAt @db.Timestamptz(6)
  product    BackofficeProduct               @relation(fields: [productId], references: [id], map: "backoffice_user_subscriptions_productId_fkey")
  profile    Profile                         @relation("BackofficeUserProductSubscriptions", fields: [profileId], references: [id], onDelete: Cascade, map: "backoffice_user_subscriptions_profileId_fkey")

  @@unique([profileId, productId], map: "backoffice_user_product_subscriptions_profile_id_product_id_key")
  @@index([profileId, status])
  @@index([productId])
  @@index([adhesionId])
  @@map("backoffice_user_product_subscriptions")
}

model ProfileSubscription {
  id                       String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId                String                       @unique @db.Uuid
  adhesionId               String?                      @unique @db.Uuid
  productId                String?                      @db.Uuid
  asaasSubscriptionId      String?
  asaasInstallmentId       String?
  subscriptionStatus       SubscriptionStatus?
  subscriptionPlan         SubscriptionPlan?
  subscriptionStartDate    DateTime?                    @db.Timestamptz(6)
  subscriptionEndDate      DateTime?                    @db.Timestamptz(6)
  trialEndDate             DateTime?                    @db.Timestamptz(6)
  subscriptionNextDueDate  DateTime?                    @db.Timestamptz(6)
  subscriptionCycle        String?
  subscriptionLastSyncedAt DateTime?                    @db.Timestamptz(6)
  hasPermanentSubscription Boolean                      @default(false)
  createdAt                DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)
  asaasCustomerId          String?
  capacity                 ProfileSubscriptionCapacity?
  adhesion                 BackofficeAdhesion?          @relation(fields: [adhesionId], references: [id], onUpdate: NoAction, map: "profile_subscriptions_adhesionId_fkey")
  product                  BackofficeProduct?           @relation(fields: [productId], references: [id], onUpdate: NoAction, map: "profile_subscriptions_productId_fkey")
  profile                  Profile                      @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "profile_subscriptions_profileId_fkey")

  @@index([adhesionId], map: "profile_subscriptions_adhesion_id_idx")
  @@index([productId], map: "profile_subscriptions_product_id_idx")
  @@index([subscriptionStatus], map: "profile_subscriptions_status_idx")
  @@map("corretor_studio_profile_subscriptions")
}

model ProfileSubscriptionCapacity {
  id                         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileSubscriptionId      String              @unique @db.Uuid
  includedExtraTeams         Int                 @default(0)
  includedExtraUsers         Int                 @default(0)
  manualAdjustmentExtraTeams Int                 @default(0)
  manualAdjustmentExtraUsers Int                 @default(0)
  createdAt                  DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  profileSubscription        ProfileSubscription @relation(fields: [profileSubscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "profile_subscription_capacities_subscription_id_fkey")

  @@map("corretor_studio_profile_subscription_capacities")
}

model ProfileUserType {
  id          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String                      @unique
  name        String
  description String?
  createdAt   DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  assignments ProfileUserTypeAssignment[]

  @@map("profile_user_types")
}

model ProfileUserTypeAssignment {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId           String          @unique(map: "profile_user_type_assignments_profile_id_key") @db.Uuid
  userTypeId          String          @db.Uuid
  accessStartsAt      DateTime?       @db.Timestamptz(6)
  accessExpiresAt     DateTime?       @db.Timestamptz(6)
  assignedByProfileId String?         @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  assignedBy          Profile?        @relation("ProfileUserTypeAssignmentAssignedBy", fields: [assignedByProfileId], references: [id], onUpdate: NoAction, map: "profile_user_type_assignments_assigned_by_profile_id_fkey")
  profile             Profile         @relation("ProfileUserTypeAssignment", fields: [profileId], references: [id], onDelete: Cascade, map: "profile_user_type_assignments_profile_id_fkey")
  userType            ProfileUserType @relation(fields: [userTypeId], references: [id], onUpdate: NoAction, map: "profile_user_type_assignments_user_type_id_fkey")

  @@index([accessExpiresAt], map: "profile_user_type_assignments_access_expires_at_idx")
  @@index([userTypeId], map: "profile_user_type_assignments_user_type_id_idx")
  @@map("profile_user_type_assignments")
}

