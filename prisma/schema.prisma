// -----------------------------
// LEADS (public.leads)
// - tenant fence by managerId (uuid of manager profile)
// - assignedTo must be operator (validate at app layer or with DB trigger via SQL)
// -----------------------------

model Lead {
  id                   String        @id @unique @default(uuid()) @db.Uuid
  leadCode             String        @unique @db.Text
  managerId            String        @db.Uuid
  teamId               String?       @db.Uuid
  assignedTo           String?       @db.Uuid
  closerId             String?       @db.Uuid
  status               LeadStatus    @default(new_opportunity)
  name                 String        @db.Text
  email                String?       @db.Text
  phone                String?       @db.Text
  cnpj                 String?       @db.Text
  age                  String?       @db.Text
  currentHealthPlan    String?       @db.Text
  currentValue         Decimal?      @db.Decimal(12, 2)
  referenceHospital    String?       @db.Text
  currentTreatment     String?       @db.Text
  meetingDate          DateTime?     @db.Timestamptz(6)
  meetingTitle         String?       @db.Text
  meetingNotes         String?       @db.Text
  meetingLink          String?       @db.Text
  meetingHeald         MeetingHeald?
  meetingType          String?       @db.Text
  followUpAt           DateTime?     @db.Timestamptz(6)
  followUpNotes        String?       @db.Text
  followUpSourceStatus LeadStatus?
  lossReason           String?       @db.Text
  lossReasonDetails    String?       @db.Text
  statusEnteredAt      DateTime      @default(now()) @db.Timestamptz(6)
  notes                String?       @db.Text

  // Novos campos para leads finalizados (apenas em edição)
  ticket          Decimal?  @db.Decimal(12, 2) // Valor que foi vendido
  contractDueDate DateTime? @db.Timestamptz(6) // Data de vigência do contrato
  soldPlan        String?   @db.Text // Plano vendido

  // Indicação / Referral
  isReferral     Boolean? @default(false)
  referrerLeadId String?  @db.Uuid
  referrerName   String?  @db.Text
  referrerPhone  String?  @db.Text

  createdBy String?  @db.Uuid
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Relations
  manager       Profile          @relation("LeadManager", fields: [managerId], references: [id], onDelete: Cascade)
  team          Team?            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee      Profile?         @relation("LeadAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  closer        Profile?         @relation("LeadCloser", fields: [closerId], references: [id], onDelete: SetNull)
  creator       Profile?         @relation("LeadCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater       Profile?         @relation("LeadUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  referrerLead  Lead?            @relation("LeadReferrer", fields: [referrerLeadId], references: [id], onDelete: SetNull)
  referredLeads Lead[]           @relation("LeadReferrer")
  activities    LeadActivity[]
  tasks         Task[]
  LeadsSchedule LeadsSchedule[]
  LeadFinalized LeadFinalized[]
  portfolio     LeadPortfolio?
  attachments   LeadAttachment[]
  dialerCalls   DialerCall[]     @relation("DialerCallLead")

  // Unique per tenant
  @@unique([teamId, email])
  @@unique([teamId, cnpj])
  @@index([teamId])
  @@index([assignedTo])
  @@index([closerId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([meetingDate])
  @@index([followUpAt])
  @@index([statusEnteredAt])
  @@map("corretor_studio_leads")
}

