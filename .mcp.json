{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "asaas": {
      "type": "http",
      "url": "https://docs.asaas.com/mcp"
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=wcnxwdcoambpfwxwubka&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cstorage"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "Sentry": {
      "url": "https://mcp.sentry.dev/mcp/corretor-studio/sentry-camel-flower"
    },
    "mcpmarket-my-toolkit": {
      "url": "https://link.mcpmarket.com/matheuswillock/toolkits/my-toolkit/mcp",
      "headers": {
        "Authorization": "Bearer ${MCPMARKET_API_TOKEN}"
      }
    }
  }
}