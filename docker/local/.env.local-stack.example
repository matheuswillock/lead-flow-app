# =============================================================================
# docker/local/.env.local-stack — segredos do stack local híbrido
# =============================================================================
#
# Copie este arquivo para docker/local/.env.local-stack (NUNCA commitado —
# coberto pela regra ".env*" do .gitignore) e preencha com os valores do
# projeto Supabase REMOTO: Dashboard -> Settings -> API.
#
# Por quê o Realtime local precisa de segredos do projeto remoto?
# Login e sessão continuam batendo no Auth remoto. O token (JWT) que chega
# no Realtime local vem sempre do Auth remoto — então o Realtime local só
# consegue validar esse token se usar o MESMO JWT secret do projeto remoto.
#
# Uso: docker compose -f docker-compose.local.yml --env-file docker/local/.env.local-stack up -d
# (os scripts `bun run local:*` já fazem isso automaticamente)
#
# =============================================================================

# Settings -> API -> Project URL (somente o host, sem "https://" e sem barra final)
SUPABASE_REMOTE_HOST=your-project-ref.supabase.co

# Settings -> API -> Project API keys
SUPABASE_REMOTE_ANON_KEY=your_remote_anon_key
SUPABASE_REMOTE_SERVICE_ROLE_KEY=your_remote_service_role_key

# Settings -> API -> JWT Settings -> JWT Secret
# Usado pelo Realtime local (API_JWT_SECRET) para validar tokens emitidos
# pelo Auth remoto — precisa ser IDÊNTICO ao secret do projeto remoto.
SUPABASE_REMOTE_JWT_SECRET=your_remote_jwt_secret
