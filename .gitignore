.claude/worktrees/

# JetBrains IDE — local settings (never commit)
.idea/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
opencode.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.evolution.example
!.env.ops.example
!.env.n8n.example
!.env.*.example
!deploy/hostinger/.env.*.example
!deploy/hostinger/.env.*.production.example

# vercel
.vercel

# db clone dumps
/tmp/
/tmp/db-clone/
/backup_*.sql

# typescript
*.tsbuildinfo
next-env.d.ts

